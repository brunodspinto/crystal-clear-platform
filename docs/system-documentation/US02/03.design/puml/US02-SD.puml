@startuml US02-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Administrator" as Admin
participant ":ReviewRegistrationUI" as UI
participant ":ReviewRegistrationController" as CTRL
participant "Repositories" as REPOS
participant "repositories:Repositories" as REPOS_SINGLETON
participant "EmailServiceFactory" as FACTORY
participant ":RegistrationRequestRepository" as REPO
participant ":RegistrationRequestMapper" as MAPPER
participant "dto:RegistrationRequestDTO" as DTO
participant "rr:RegistrationRequest" as RR
participant ":AuthenticationRepository" as AUTH
participant ":EmailService" as EMAIL

activate Admin

    Admin -> UI : asks to review registration requests
    activate UI

        UI --> CTRL** : create()
        activate CTRL
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS

            CTRL -> REPOS_SINGLETON : getRegistrationRequestRepository()
            activate REPOS_SINGLETON
                REPOS_SINGLETON --> CTRL : registrationRequestRepository
            deactivate REPOS_SINGLETON

            CTRL -> REPOS_SINGLETON : getAuthenticationRepository()
            activate REPOS_SINGLETON
                REPOS_SINGLETON --> CTRL : authenticationRepository
            deactivate REPOS_SINGLETON

            CTRL -> FACTORY : create()
            activate FACTORY
                FACTORY --> CTRL : emailService
            deactivate FACTORY

            CTRL --> MAPPER** : create()
        deactivate CTRL

        UI -> CTRL : getPendingRequestsAsDTO()
        activate CTRL
            CTRL -> AUTH : getCurrentUserSession()
            activate AUTH
                AUTH --> CTRL : session
            deactivate AUTH

            note right of CTRL
                verifies the session belongs to an Administrator;
                the same check is done in approveRequestByEmail
                and rejectRequestByEmail
            end note

            CTRL -> REPO : getPendingRequests()
            activate REPO
                REPO --> CTRL : pendingRequests
            deactivate REPO

            CTRL -> MAPPER : toDTO(pendingRequests)
            activate MAPPER
                loop for each request in pendingRequests
                    MAPPER --> DTO** : new RegistrationRequestDTO(fullName, email, role,\nsubmissionDate, identificationDocument)
                end
                MAPPER --> CTRL : pendingRequestDTOs
            deactivate MAPPER

            CTRL --> UI : pendingRequestDTOs
        deactivate CTRL
        UI --> Admin : displays list of pending requests
    deactivate UI

    Admin -> UI : selects a request and decides to accept/reject
    activate UI
        UI --> Admin : shows full request details and asks for decision
    deactivate UI

    alt accept
        Admin -> UI : confirms acceptance
        activate UI
            UI -> CTRL : approveRequestByEmail(dto.getEmail())
            activate CTRL
                CTRL -> REPO : findPendingByEmail(email)
                activate REPO
                    REPO --> CTRL : rr
                deactivate REPO
                CTRL -> RR : approve()
                activate RR
                    RR --> CTRL : ok
                deactivate RR
                CTRL -> AUTH : addUserWithRole(fullName, email, password, roleId)
                activate AUTH
                    AUTH --> CTRL : ok
                deactivate AUTH
                CTRL -> EMAIL : sendNotification(email, subject, body)
                activate EMAIL
                    EMAIL --> CTRL : ok
                deactivate EMAIL
                CTRL --> UI : ok
            deactivate CTRL
            UI --> Admin : displays request accepted
        deactivate UI

    else reject
        Admin -> UI : confirms rejection with reason
        activate UI
            UI -> CTRL : rejectRequestByEmail(dto.getEmail(), reason)
            activate CTRL
                CTRL -> REPO : findPendingByEmail(email)
                activate REPO
                    REPO --> CTRL : rr
                deactivate REPO
                CTRL -> RR : reject(reason)
                activate RR
                    RR --> CTRL : ok
                deactivate RR
                CTRL -> EMAIL : sendNotification(email, subject, body)
                activate EMAIL
                    EMAIL --> CTRL : ok
                deactivate EMAIL
                CTRL --> UI : ok
            deactivate CTRL
            UI --> Admin : displays request rejected
        deactivate UI
    end

deactivate Admin

@enduml
