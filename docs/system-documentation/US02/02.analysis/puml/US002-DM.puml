@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

hide circle
hide methods

title Domain Model Excerpt - US002

class Administrator {
}

class RegistrationRequest {
    - fullName: String
    - email: String
    - identificationDocument: String
    - status: Status
    - submissionDate: Date
    - rejectionReason: String
}

class User {
    - fullName: String
    - email: String
    - password: String
}

enum Status {
    PENDING
    APPROVED
    REJECTED
}

enum Role {
    POLITICAL_AGENT
    ORDINARY_CITIZEN
    JOURNALIST
    ETHICS_COMMITTEE
    SYSTEM_ADMINISTRATOR
}

Administrator "1" -- "*" RegistrationRequest : reviews >
RegistrationRequest "1" -- "1" Status : has >
RegistrationRequest "1" -- "1" Role : requests >
RegistrationRequest ..> User : activates >

@enduml
