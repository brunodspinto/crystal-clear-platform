@startuml US09-SD-full
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Ethics Committee Member" as ECM
participant ":ConsultIntegratedSituationUI" as UI
participant ":ConsultIntegratedSituationController" as CTRL
participant ":PoliticalAgentRepository" as PAR
participant ":DeclarationRepository" as DR
participant "d:Declaration" as DEC

activate ECM

    ECM -> UI : asks to consult integrated situation
    activate UI

        UI -> CTRL : getPoliticalAgents()
        activate CTRL

            CTRL -> PAR : getAll()
            activate PAR
                PAR --> CTRL : agents
            deactivate PAR

            CTRL --> UI : agents
        deactivate CTRL

        UI --> ECM : shows agent list, requests selection
    deactivate UI

    ECM -> UI : selects agent (AC1)
    activate UI

        UI --> ECM : requests reference date
    deactivate UI

    ECM -> UI : enters reference date
    activate UI

        UI -> CTRL : getIntegratedSituation(agent, referenceDate)
        activate CTRL

            CTRL -> DR : getValidatedDeclarationsForAgentUpTo(agent, referenceDate)
            activate DR

                note right of DR
                    AC2: only declarations with
                    status = VALIDATED and
                    submissionDate <= referenceDate
                end note

                DR --> CTRL : declarations
            deactivate DR

            CTRL --> UI : declarations
        deactivate CTRL

        alt declarations is empty (AC3)
            UI --> ECM : shows "no validated declarations up to that date"
        else
            loop for each d in declarations
                UI -> DEC : getPositionEntries()
                activate DEC
                    DEC --> UI : positionEntries
                deactivate DEC

                UI -> DEC : getIncomes()
                activate DEC
                    DEC --> UI : incomes
                deactivate DEC

                UI -> DEC : getSubsidyEntries()
                activate DEC
                    DEC --> UI : subsidyEntries
                deactivate DEC

                UI -> DEC : getAssetEntries()
                activate DEC
                    DEC --> UI : assetEntries
                deactivate DEC

                UI -> DEC : getBusinessParticipations()
                activate DEC
                    DEC --> UI : participations
                deactivate DEC
            end

            UI --> ECM : shows integrated situation\n(positions, incomes, subsidies, assets, participations)
        end

    deactivate UI

deactivate ECM
@enduml
