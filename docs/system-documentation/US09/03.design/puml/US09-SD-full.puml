@startuml US09-SD-full
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Ethics Committee Member" as ECM
participant ":ConsultIntegratedSituationUI" as UI
participant ":ConsultIntegratedSituationController" as CTRL
participant ":PoliticalAgentRepository" as PAR
participant ":DeclarationRepository" as DR
participant "d:Declaration" as DEC

activate ECM

    ECM -> UI : asks to consult integrated situation
    activate UI

        UI -> CTRL : getPoliticalAgents()
        activate CTRL

            CTRL -> PAR : getPoliticalAgents()
            activate PAR
                PAR --> CTRL : agents
            deactivate PAR

            CTRL --> UI : agents
        deactivate CTRL

        UI --> ECM : shows agent list, requests selection
    deactivate UI

    ECM -> UI : selects agent (AC1)
    activate UI

        UI --> ECM : requests reference date
    deactivate UI

    ECM -> UI : enters reference date
    activate UI

        UI -> CTRL : getIntegratedSituation(agent, referenceDate)
        activate CTRL

            CTRL -> DR : getValidatedDeclarationsUpTo(agent, referenceDate)
            activate DR

                note right of DR
                    AC2: only declarations with
                    status = VALIDATED and
                    submissionDate <= referenceDate
                end note

                DR --> CTRL : declarations
            deactivate DR

            alt declarations is empty (AC3)
                CTRL --> UI : empty situation
            else
                loop for each d in declarations
                    CTRL -> DEC : getPosition()
                    activate DEC
                        DEC --> CTRL : position
                    deactivate DEC

                    CTRL -> DEC : getIncomes()
                    activate DEC
                        DEC --> CTRL : incomes
                    deactivate DEC

                    CTRL -> DEC : getAssets()
                    activate DEC
                        DEC --> CTRL : assets
                    deactivate DEC

                    CTRL -> DEC : getBusinessParticipations()
                    activate DEC
                        DEC --> CTRL : participations
                    deactivate DEC
                end

                CTRL --> UI : integrated situation
            end

        deactivate CTRL

        alt declarations is empty (AC3)
            UI --> ECM : shows "no validated declarations up to that date"
        else
            UI --> ECM : shows integrated situation\n(positions, income, assets, participations)
        end

    deactivate UI

deactivate ECM
@enduml
