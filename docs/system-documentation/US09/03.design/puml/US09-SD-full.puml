@startuml US09-SD-full
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Ethics Committee Member" as ECM
participant ":ConsultIntegratedSituationUI" as UI
participant ":ConsultIntegratedSituationController" as CTRL
participant ":Repositories" as REPOS
participant ":PoliticalAgentRepository" as PAR
participant ":DeclarationRepository" as DR
participant ":PoliticalAgentMapper" as PAM
participant ":DeclarationMapper" as DM

activate ECM

    ECM -> UI : asks to consult integrated situation
    activate UI

        UI -> CTRL** : create()
        activate CTRL
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS

            CTRL -> REPOS : getPoliticalAgentRepository()
            activate REPOS
                REPOS --> CTRL : politicalAgentRepository
            deactivate REPOS

            CTRL -> REPOS : getDeclarationRepository()
            activate REPOS
                REPOS --> CTRL : declarationRepository
            deactivate REPOS
        deactivate CTRL

        UI -> CTRL : getPoliticalAgents()
        activate CTRL

            CTRL -> PAR : getAll()
            activate PAR
                PAR --> CTRL : agents
            deactivate PAR

            CTRL -> PAM : toDTO(agents)
            activate PAM
                PAM --> CTRL : agentsDto
            deactivate PAM

            CTRL --> UI : agentsDto
        deactivate CTRL

        UI --> ECM : shows agent list, requests selection
    deactivate UI

    ECM -> UI : selects agent (AC1)
    activate UI

        UI --> ECM : requests reference date
    deactivate UI

    ECM -> UI : enters reference date
    activate UI

        UI -> CTRL : getIntegratedSituation(agentDto, referenceDate)
        activate CTRL

            alt agentDto == null
                CTRL --> UI : throw IllegalArgumentException("Agent cannot be null.")
            else referenceDate == null
                CTRL --> UI : throw IllegalArgumentException("Reference date cannot be null.")
            else valid input
                CTRL -> PAR : getByEmail(agentDto.getEmail())
                activate PAR
                    PAR --> CTRL : agent
                deactivate PAR

                CTRL -> DR : getValidatedDeclarationsForAgentUpTo(agent, referenceDate)
                activate DR

                    note right of DR
                        AC2: only declarations with
                        status = VALIDATED and
                        submissionDate <= referenceDate
                    end note

                    DR --> CTRL : declarations
                deactivate DR

                CTRL -> DM : toDTO(declarations)
                activate DM
                    DM --> CTRL : declarationsDto
                deactivate DM

                CTRL --> UI : declarationsDto
            end
        deactivate CTRL

        alt declarationsDto is empty (AC3)
            UI --> ECM : shows "no validated declarations up to that date"
        else
            note right of UI
                each DeclarationDTO already carries the
                entry lines (positions, incomes, subsidies,
                assets, participations) as display-ready
                strings, so the UI does not touch the domain
            end note

            UI --> ECM : shows integrated situation\n(positions, incomes, subsidies, assets, participations)
        end

    deactivate UI

deactivate ECM
@enduml
