@startuml US09-CD
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class ConsultIntegratedSituationUI {
}

class ConsultIntegratedSituationController {
    + ConsultIntegratedSituationController()
    + getPoliticalAgents() : List<PoliticalAgent>
    + getIntegratedSituation(agent, referenceDate) : List<Declaration>
}

class Repositories <<Singleton>> {
    - {static} instance : Repositories
    - Repositories()
    + {static} getInstance() : Repositories
    + getPoliticalAgentRepository() : PoliticalAgentRepository
    + getDeclarationRepository() : DeclarationRepository
}

class PoliticalAgentRepository {
    + getAll() : List<PoliticalAgent>
}

class DeclarationRepository {
    + getValidatedDeclarationsForAgentUpTo(agent, referenceDate) : List<Declaration>
}

class PoliticalAgent {
    - name
    - email
    - nationalIdentityCard
    - taxIdentificationNumber
}

class "Declaration of Interests" as Declaration {
    - id
    - submissionDate
    - status
    - type
    + getPositionEntries()
    + getIncomes()
    + getSubsidyEntries()
    + getAssetEntries()
    + getBusinessParticipations()
}

enum DeclarationStatus <<enumeration>> {
    PENDING
    VALIDATED
    REJECTED
}

enum DeclarationType <<enumeration>> {
    INITIAL
    REGULAR
    EXCEPTIONAL
}

class PositionEntry {
    - functionDesignation
    - nature
    - grossSalary
    - sideIncomeConsulting
    - sideIncomeBoardMemberships
    - startDate
    - endDate
}

class Income {
    - amount
    - source
    - date
}

class SubsidyEntry {
    - amount
    - description
    - date
}

class AssetEntry {
    - assetType
    - assetValue
}

class BusinessParticipation {
    - companyNIF
    - totalValueInStocks
    - companyPercentage
}

ConsultIntegratedSituationUI .> ConsultIntegratedSituationController

ConsultIntegratedSituationController ..> Repositories
Repositories ..> PoliticalAgentRepository
Repositories ..> DeclarationRepository
ConsultIntegratedSituationController ..> PoliticalAgentRepository
ConsultIntegratedSituationController ..> DeclarationRepository
ConsultIntegratedSituationController ..> PoliticalAgent
ConsultIntegratedSituationController ..> Declaration

ConsultIntegratedSituationUI ..> Declaration
ConsultIntegratedSituationUI ..> PositionEntry
ConsultIntegratedSituationUI ..> Income
ConsultIntegratedSituationUI ..> SubsidyEntry
ConsultIntegratedSituationUI ..> AssetEntry
ConsultIntegratedSituationUI ..> BusinessParticipation

PoliticalAgentRepository --> "*" PoliticalAgent : agents
DeclarationRepository --> "*" Declaration : declarations

PoliticalAgent "1" -- "*" Declaration : submits >
Declaration "*" -- "1" DeclarationStatus : has >
Declaration "*" -- "1" DeclarationType : has >
Declaration "1" *-- "*" PositionEntry : holds >
Declaration "1" *-- "*" Income : includes >
Declaration "1" *-- "*" SubsidyEntry : includes >
Declaration "1" *-- "*" AssetEntry : declares >
Declaration "1" *-- "*" BusinessParticipation : declares >

note bottom of DeclarationRepository
    AC2: returns only declarations with
    status = VALIDATED and
    submissionDate <= referenceDate
end note

note right of ConsultIntegratedSituationController
    getIntegratedSituation validates inputs:
    throws IllegalArgumentException if agent or
    referenceDate is null, before calling the repository.
end note

@enduml
