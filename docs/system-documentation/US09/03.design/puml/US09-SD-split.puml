@startuml US09-SD-split
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Ethics Committee Member" as ECM
participant ":ConsultIntegratedSituationUI" as UI
participant ":ConsultIntegratedSituationController" as CTRL

activate ECM

    ECM -> UI : asks to consult integrated situation
    activate UI

        UI --> CTRL** : create()
        UI -> CTRL : getPoliticalAgents()
        ref over CTRL
            Get Political Agents
        end ref

        activate CTRL
            CTRL --> UI : agents
        deactivate CTRL

        UI --> ECM : shows agent list, requests selection
    deactivate UI

    ECM -> UI : selects agent (AC1)
    activate UI
        UI --> ECM : requests reference date
    deactivate UI

    ECM -> UI : enters reference date
    activate UI

        UI -> CTRL : getIntegratedSituation(agent, referenceDate)
        activate CTRL

            CTRL -> CTRL : getValidatedDeclarationsUpTo(agent, referenceDate)
            activate CTRL
                ref over CTRL
                    Get Validated Declarations Up To Date
                end ref
                CTRL --> CTRL : declarations
            deactivate CTRL

            CTRL -> CTRL : aggregateIntegratedSituation(declarations)
            activate CTRL
                ref over CTRL
                    Aggregate Integrated Situation
                end ref
                CTRL --> CTRL : situation
            deactivate CTRL

            CTRL --> UI : integrated situation
        deactivate CTRL

        alt declarations is empty (AC3)
            UI --> ECM : shows "no validated declarations up to that date"
        else
            UI --> ECM : shows integrated situation\n(positions, income, assets, participations)
        end

    deactivate UI

deactivate ECM
@enduml
