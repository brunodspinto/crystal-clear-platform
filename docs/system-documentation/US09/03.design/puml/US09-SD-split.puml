@startuml US09-SD-split
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Ethics Committee Member" as ECM
participant ":ConsultIntegratedSituationUI" as UI
participant ":ConsultIntegratedSituationController" as CTRL
participant ":Repositories" as REPOS

activate ECM

    ECM -> UI : asks to consult integrated situation
    activate UI

        UI -> CTRL** : create()
        activate CTRL
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS

            CTRL -> REPOS : getPoliticalAgentRepository()
            activate REPOS
                REPOS --> CTRL : politicalAgentRepository
            deactivate REPOS

            CTRL -> REPOS : getDeclarationRepository()
            activate REPOS
                REPOS --> CTRL : declarationRepository
            deactivate REPOS
        deactivate CTRL

        UI -> CTRL : getPoliticalAgents()
        ref over CTRL
            Get Political Agents
        end ref

        activate CTRL
            CTRL --> UI : agentsDto
        deactivate CTRL

        UI --> ECM : shows agent list, requests selection
    deactivate UI

    ECM -> UI : selects agent (AC1)
    activate UI
        UI --> ECM : requests reference date
    deactivate UI

    ECM -> UI : enters reference date
    activate UI

        UI -> CTRL : getIntegratedSituation(agentDto, referenceDate)
        activate CTRL

            alt agentDto == null
                CTRL --> UI : throw IllegalArgumentException("Agent cannot be null.")
            else referenceDate == null
                CTRL --> UI : throw IllegalArgumentException("Reference date cannot be null.")
            else valid input
                ref over CTRL
                    Get Validated Declarations For Agent Up To
                end ref

                CTRL --> UI : declarationsDto
            end
        deactivate CTRL

        alt declarationsDto is empty (AC3)
            UI --> ECM : shows "no validated declarations up to that date"
        else
            ref over UI
                Display Declarations
            end ref
            UI --> ECM : shows integrated situation\n(positions, incomes, subsidies, assets, participations)
        end

    deactivate UI

deactivate ECM
@enduml
