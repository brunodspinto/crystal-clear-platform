@startuml US01-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Future User" as User
participant ":RegisterUI" as UI
participant ":RegisterController" as CTRL
participant "rr:RegistrationRequest" as RR
participant "Repositories" as REPOS
participant "repositories:Repositories" as REPOS_SINGLETON
participant ":RegistrationRequestRepository" as REPO

activate User

    User -> UI : asks to register on the platform
    activate UI
        UI -> CTRL : getAvailableRoles()
        activate CTRL
            CTRL --> UI : roles
        deactivate CTRL
        UI --> User : shows available roles and requests selection
    deactivate UI

    User -> UI : selects role and types data\n(fullName, email, password)
    activate UI
        UI -> CTRL : isValidPassword(password)
        activate CTRL
            CTRL --> UI : true/false
        deactivate CTRL
        UI -> CTRL : requiresDocument(role)
        activate CTRL
            CTRL --> UI : required
        deactivate CTRL

        opt document is required (Journalist or Citizen)
            UI --> User : requests identification document
            User -> UI : types identification document
        end

        UI --> User : shows all data and requests confirmation
    deactivate UI

    User -> UI : confirms data
    activate UI

        UI -> CTRL : submitRequest(fullName, email, password, role, identificationDocument)
        activate CTRL

            CTRL -> RR ** : new RegistrationRequest(fullName, email, password, role, identificationDocument)
            activate RR
                RR --> CTRL : rr
            deactivate RR

            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS

            CTRL -> REPOS_SINGLETON : getRegistrationRequestRepository()
            activate REPOS_SINGLETON
                REPOS_SINGLETON --> CTRL : registrationRequestRepository
            deactivate REPOS_SINGLETON

            CTRL -> REPO : save(rr)
            activate REPO
                REPO --> CTRL : success
            deactivate REPO

            CTRL --> UI : success
        deactivate CTRL

        UI --> User : displays operation success
    deactivate UI

deactivate User

@enduml
