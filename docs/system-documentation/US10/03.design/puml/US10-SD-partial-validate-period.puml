@startuml US10-SD-partial-validate-period
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

participant ":AnalyseIncomeEvolutionController" as CTRL

autonumber 7
 -> CTRL : getIncomeEvolution(agent, startDate, endDate)
autonumber 7.1
activate CTRL
    group Validate Period (inline, AC2)

        note right of CTRL
            AC2: validates inline that
            startDate <= endDate.
            Throws IllegalArgumentException
            if violated.
        end note

        CTRL -> CTRL : check startDate.after(endDate)
        activate CTRL
            CTRL --> CTRL : ok
        deactivate CTRL

    end
deactivate CTRL

@enduml
