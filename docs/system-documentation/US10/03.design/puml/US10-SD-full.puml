@startuml US10-SD-full
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Journalist" as Journalist
participant ":AnalyseIncomeEvolutionUI" as UI
participant ":AnalyseIncomeEvolutionController" as CTRL
participant ":Repositories" as REPOS
participant ":PoliticalAgentRepository" as PAR
participant ":DeclarationRepository" as DR
participant ":PoliticalAgentMapper" as PAM
participant ":DeclarationMapper" as DM

activate Journalist

    Journalist -> UI : asks to analyse income evolution
    activate UI

        UI --> CTRL** : create()
        activate CTRL
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS

            CTRL -> REPOS : getPoliticalAgentRepository()
            activate REPOS
                REPOS --> CTRL : politicalAgentRepository
            deactivate REPOS

            CTRL -> REPOS : getDeclarationRepository()
            activate REPOS
                REPOS --> CTRL : declarationRepository
            deactivate REPOS
        deactivate CTRL

        UI -> CTRL : getPoliticalAgents()
        activate CTRL

            CTRL -> PAR : getAll()
            activate PAR
                PAR --> CTRL : agents
            deactivate PAR

            CTRL -> PAM : toDTO(agents)
            activate PAM
                PAM --> CTRL : agentsDto
            deactivate PAM

            CTRL --> UI : agentsDto
        deactivate CTRL

        UI --> Journalist : shows agent list, requests selection
    deactivate UI

    Journalist -> UI : selects agent (AC1)
    activate UI

        UI --> Journalist : requests start date and end date
    deactivate UI

    Journalist -> UI : enters start date and end date
    activate UI

        UI -> CTRL : getIncomeEvolution(agentDto, startDate, endDate)
        activate CTRL

            alt agentDto == null
                CTRL --> UI : throw IllegalArgumentException("Agent cannot be null.")
            else startDate == null or endDate == null
                CTRL --> UI : throw IllegalArgumentException("Dates cannot be null.")
            else startDate.after(endDate) (AC2)
                CTRL --> UI : throw IllegalArgumentException("Start date must be before or equal to end date.")
            else valid input
                CTRL -> PAR : getByEmail(agentDto.getEmail())
                activate PAR
                    PAR --> CTRL : agent
                deactivate PAR

                CTRL -> DR : getValidatedDeclarationsForAgentBetween(agent, startDate, endDate)
                activate DR

                    note right of DR
                        AC3: only declarations with
                        status = VALIDATED in [start, end]
                        AC4: ordered by submissionDate
                    end note

                    DR --> CTRL : declarations
                deactivate DR

                CTRL -> DM : toDTO(declarations)
                activate DM
                    DM --> CTRL : declarationsDto
                deactivate DM

                CTRL --> UI : declarationsDto
            end
        deactivate CTRL

        alt declarationsDto is empty (AC5)
            UI --> Journalist : shows "no validated declarations in period"
        else
            note right of UI
                each DeclarationDTO already carries the
                submission date, type, entry lines and the
                total income as display-ready data, so the
                UI does not touch the domain
            end note

            UI --> Journalist : shows declarations with income evolution\n(chronological)
        end

    deactivate UI

deactivate Journalist
@enduml
