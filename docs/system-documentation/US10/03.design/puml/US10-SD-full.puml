@startuml US10-SD-full
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Journalist" as Journalist
participant ":AnalyseIncomeEvolutionUI" as UI
participant ":AnalyseIncomeEvolutionController" as CTRL
participant ":PoliticalAgentRepository" as PAR
participant ":DeclarationRepository" as DR
participant "d:Declaration" as DEC

activate Journalist

    Journalist -> UI : asks to analyse income evolution
    activate UI

        UI -> CTRL : getPoliticalAgents()
        activate CTRL

            CTRL -> PAR : getAll()
            activate PAR
                PAR --> CTRL : agents
            deactivate PAR

            CTRL --> UI : agents
        deactivate CTRL

        UI --> Journalist : shows agent list, requests selection
    deactivate UI

    Journalist -> UI : selects agent (AC1)
    activate UI

        UI --> Journalist : requests start date and end date
    deactivate UI

    Journalist -> UI : enters start date and end date
    activate UI

        UI -> CTRL : getIncomeEvolution(agent, startDate, endDate)
        activate CTRL

            note right of CTRL
                AC2: validates inline
                that startDate <= endDate;
                throws IllegalArgumentException
                otherwise.
            end note

            CTRL -> DR : getValidatedDeclarationsForAgentBetween(agent, startDate, endDate)
            activate DR

                note right of DR
                    AC3: only declarations with
                    status = VALIDATED in [start, end]
                    AC4: ordered by submissionDate
                end note

                DR --> CTRL : declarations
            deactivate DR

            CTRL --> UI : declarations
        deactivate CTRL

        alt declarations is empty (AC5)
            UI --> Journalist : shows "no validated declarations in period"
        else
            loop for each d in declarations
                UI -> DEC : getSubmissionDate()
                activate DEC
                    DEC --> UI : submissionDate
                deactivate DEC

                UI -> DEC : getType()
                activate DEC
                    DEC --> UI : type
                deactivate DEC

                UI -> DEC : getIncomes()
                activate DEC
                    DEC --> UI : incomes
                deactivate DEC

                UI -> DEC : getSubsidyEntries()
                activate DEC
                    DEC --> UI : subsidyEntries
                deactivate DEC
            end

            UI --> Journalist : shows declarations with income evolution\n(chronological)
        end

    deactivate UI

deactivate Journalist
@enduml
