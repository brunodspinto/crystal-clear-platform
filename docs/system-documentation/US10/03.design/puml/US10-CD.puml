@startuml US10-CD
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class AnalyseIncomeEvolutionUI {
}

class AnalyseIncomeEvolutionController {
    + AnalyseIncomeEvolutionController()
    + getPoliticalAgents()
    + getIncomeEvolution(agent, startDate, endDate)
}

class PoliticalAgentRepository {
    + getAll()
}

class DeclarationRepository {
    + getValidatedDeclarationsForAgentBetween(agent, startDate, endDate)
}

class PoliticalAgent {
    - name
    - email
    - nationalIdentityCard
    - taxIdentificationNumber
}

class "Declaration of Interests" as Declaration {
    - id
    - submissionDate
    - status
    - type
    + getIncomes()
    + getSubsidyEntries()
    + getType()
    + getSubmissionDate()
}

enum DeclarationStatus <<enumeration>> {
    PENDING
    VALIDATED
    REJECTED
}

enum DeclarationType <<enumeration>> {
    INITIAL
    REGULAR
    EXCEPTIONAL
}

class Income {
    - amount
    - source
    - date
}

class SubsidyEntry {
    - amount
    - description
    - date
}

AnalyseIncomeEvolutionUI .> AnalyseIncomeEvolutionController

AnalyseIncomeEvolutionController ..> PoliticalAgentRepository
AnalyseIncomeEvolutionController ..> DeclarationRepository
AnalyseIncomeEvolutionController ..> PoliticalAgent
AnalyseIncomeEvolutionController ..> Declaration

AnalyseIncomeEvolutionUI ..> Declaration
AnalyseIncomeEvolutionUI ..> Income
AnalyseIncomeEvolutionUI ..> SubsidyEntry

PoliticalAgentRepository --> "*" PoliticalAgent : agents
DeclarationRepository --> "*" Declaration : declarations

PoliticalAgent "1" -- "*" Declaration : submits >
Declaration "*" -- "1" DeclarationStatus : has >
Declaration "*" -- "1" DeclarationType : has >
Declaration "1" *-- "*" Income : includes >
Declaration "1" *-- "*" SubsidyEntry : includes >

note right of AnalyseIncomeEvolutionController
    AC2: validates inline that
    startDate <= endDate before
    calling the repository.
end note

note bottom of DeclarationRepository
    AC3: returns only declarations
    with status = VALIDATED in [start, end]
    AC4: result is sorted by submissionDate
end note

@enduml
