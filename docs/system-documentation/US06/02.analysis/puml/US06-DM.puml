@startuml US06-DM
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class "Political Agent" as PoliticalAgent {
    name
    email
    nationalIdentityCard
    taxIdentificationNumber
    mandateStart
    mandateEnd
}

class "Declaration of Interests" as Declaration {
    id
    name
    submissionDate
}

enum DeclarationType {
    initial
    regular
    exceptional
}

enum DeclarationStatus {
    pending
    validated
    rejected
}

enum PoliticalFunction {
    minister
    deputy
    councillor
    parishCouncilPresident
    mayor
}

class PositionEntry {
    nature
    grossSalary
    sideIncome
    startDate
    endDate
}

class Function {
    designation
}

class Organization {
    name
}

enum OrganizationType {
    company
    politicalParty
    foundation
    institute
    association
}

class SubsidyEntry {
    amount
    description
    date
}

class AssetEntry {
    assetValue
}

enum AssetType {
    realEstate
    vehicles
    stocks
}

class "Real Estate" as RealEstate {
    description
    municipality
}

class VehicleAsset {
    description
}

class StockAsset {
    description
}

class BusinessParticipation {
    companyNIF
    totalValueInStocks
    companyPercentage
}

class Attachment {
    fileName
    uploadDate
}

PoliticalAgent "1" -- "1" PoliticalFunction : has
PoliticalAgent "1" -- "*" Declaration : submits

Declaration "*" -- "1" DeclarationType : classified as
Declaration "*" -- "1" DeclarationStatus : has
Declaration "1" -- "1..*" PositionEntry : includes
Declaration "1" -- "*" SubsidyEntry : includes
Declaration "1" -- "*" AssetEntry : includes
Declaration "1" -- "*" BusinessParticipation : includes
Declaration "1" *-- "*" Attachment : has

PositionEntry "*" -- "1" Organization : held at
PositionEntry "*" -- "1" Function : performs

Organization "*" -- "1" OrganizationType : classified as

SubsidyEntry "*" -- "1" Organization : received from

AssetEntry "*" -- "1" AssetType : classified as
AssetEntry "1" -- "0..1" RealEstate : described by
AssetEntry "1" -- "0..1" VehicleAsset : described by
AssetEntry "1" -- "0..1" StockAsset : described by

BusinessParticipation "*" -- "1" Organization : held in

@enduml
