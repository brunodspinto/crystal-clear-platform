@startuml US06-DM
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class "Political Agent" as PoliticalAgent {
    name: String
    email: String
    nationalIdentityCard: String
    taxIdentificationNumber: String
    mandateStart: Date
    mandateEnd: Date
}

class "Declaration of Interests" as Declaration {
    id: String
    name: String
    submissionDate: Date
}

enum DeclarationType {
    initial
    regular
    exceptional
}

enum DeclarationStatus {
    pending
    validated
    rejected
}

enum PoliticalFunction {
    minister
    deputy
    councillor
    parishCouncilPresident
    mayor
}

class PositionEntry {
    nature: String
    remuneration: Double
    startDate: Date
    endDate: Date
}

class Function {
    designation: String
}

class Institution {
    name: String
    type: String
}

class SubsidyEntry {
    amount: Double
    description: String
    date: Date
}

class AssetEntry {
    acquisitionValue: Double
    marketValue: Double
}

class "Real Estate" as RealEstate {
    description: String
    municipality: String
}

enum AssetType {
    urban
    rural
}

class BusinessParticipation {
    numberOfShares: Integer
    marketValue: Double
}

PoliticalAgent "1" -- "1" PoliticalFunction : has
PoliticalAgent "1" -- "*" Declaration : submits

Declaration "*" -- "1" DeclarationType : classified as
Declaration "*" -- "1" DeclarationStatus : has
Declaration "1" -- "1..*" PositionEntry : includes
Declaration "1" -- "*" SubsidyEntry : includes
Declaration "1" -- "*" AssetEntry : includes
Declaration "1" -- "*" BusinessParticipation : includes

PositionEntry "*" -- "1" Institution : held at
PositionEntry "*" -- "1" Function : performs

SubsidyEntry "*" -- "1" Institution : received from

AssetEntry "*" -- "1" AssetType : classified as
AssetEntry "1" -- "1" RealEstate : described by

class Attachment {
    fileName: String
    uploadDate: Date
}

BusinessParticipation "*" -- "1" Institution : held in

Declaration "1" -- "*" Attachment : includes

@enduml
