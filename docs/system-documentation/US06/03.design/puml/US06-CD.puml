@startuml US06-CD
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class SubmitDeclarationUI {
}

class SubmitDeclarationController {
    + SubmitDeclarationController()
    + getDeclarationTypes() : List<DeclarationType>
    + getOrganizations() : List<Organization>
    + getPositionNatures() : List<PositionNature>
    + getAssetTypes() : List<AssetType>
    + submitDeclaration(type, positionEntries, subsidyEntries,\nassetEntries, businessParticipations, attachments) : boolean
    - getCurrentPoliticalAgent() : PoliticalAgent
}

class Repositories <<Singleton>> {
    - {static} instance : Repositories
    - Repositories()
    + {static} getInstance() : Repositories
    + getOrganizationRepository() : OrganizationRepository
    + getDeclarationRepository() : DeclarationRepository
    + getPoliticalAgentRepository() : PoliticalAgentRepository
    + getAuthenticationRepository() : AuthenticationRepository
}

class OrganizationRepository {
    + getOrganizations() : List<Organization>
}

class DeclarationRepository {
    + save(declaration : Declaration) : boolean
}

class PoliticalAgentRepository {
    + getByEmail(email : String) : PoliticalAgent
}

class AuthenticationRepository {
    + getCurrentUserSession() : UserSession
}

class PoliticalAgent {
    - name : String
    - email : String
    - nationalIdentityCard : String
    - taxIdentificationNumber : String
    - mandateStart : Date
    - mandateEnd : Date
}

class Declaration {
    - id : String
    - submissionDate : Date
    - status : DeclarationStatus
    + Declaration(type : DeclarationType, agent : PoliticalAgent, submissionDate : Date)
    + addPositionEntry(organization, functionDesignation, nature,\ngrossSalary, sideIncomeConsulting, sideIncomeBoardMemberships,\nstartDate, endDate)
    + addIncome(organization, amount, source, date)
    + addSubsidyEntry(organization, amount, description, date)
    + addAssetEntry(assetType, assetValue, detail)
    + addBusinessParticipation(organization, companyNIF,\ntotalValueInStocks, companyPercentage)
    + addAttachment(fileName, uploadDate)
}

class PositionEntry {
    - functionDesignation : String
    - nature : PositionNature
    - grossSalary : double
    - sideIncomeConsulting : double
    - sideIncomeBoardMemberships : double
    - startDate : Date
    - endDate : Date
}

class Income {
    - amount : double
    - source : String
    - date : Date
}

class SubsidyEntry {
    - amount : double
    - description : String
    - date : Date
}

class AssetEntry {
    - assetValue : double
}

class RealEstate {
    - description : String
    - municipality : String
}

class VehicleAsset {
    - description : String
}

class StockAsset {
    - description : String
}

class BusinessParticipation {
    - companyNIF : long
    - totalValueInStocks : double
    - companyPercentage : double
}

class Organization {
    - name : String
}

class Attachment {
    - fileName : String
    - uploadDate : Date
}

enum DeclarationType {
    INITIAL
    REGULAR
    EXCEPTIONAL
}

enum DeclarationStatus {
    PENDING
    VALIDATED
    REJECTED
}

enum AssetType {
    REAL_ESTATE
    VEHICLES
    STOCKS
}

enum PositionNature {
    PUBLIC
    PRIVATE
    SOCIAL
}

' ── UI → Controller ───────────────────────────────────────────────────────────
SubmitDeclarationUI .> SubmitDeclarationController

' ── Controller → Repositories (GRASP: accesses singleton to obtain repos) ─────
SubmitDeclarationController ..> Repositories : uses

' ── Controller → Repositories (direct use after obtaining from singleton) ──────
SubmitDeclarationController ..> OrganizationRepository : uses
SubmitDeclarationController ..> DeclarationRepository : uses
SubmitDeclarationController ..> PoliticalAgentRepository : uses
SubmitDeclarationController ..> AuthenticationRepository : uses
SubmitDeclarationController ..> Declaration : creates
SubmitDeclarationController ..> PoliticalAgent : uses

' ── Repositories singleton owns all repositories ──────────────────────────────
Repositories *-- OrganizationRepository
Repositories *-- DeclarationRepository
Repositories *-- PoliticalAgentRepository
Repositories *-- AuthenticationRepository

' ── Repositories store domain objects ─────────────────────────────────────────
OrganizationRepository --> "*" Organization : stores
DeclarationRepository --> "*" Declaration : stores
PoliticalAgentRepository --> "*" PoliticalAgent : stores

' ── Declaration aggregate ─────────────────────────────────────────────────────
Declaration --> "1" PoliticalAgent : agent
Declaration --> "1" DeclarationType : type
Declaration --> "1" DeclarationStatus : status
Declaration *-- "*" PositionEntry : positionEntries
Declaration *-- "*" Income : incomes
Declaration *-- "*" SubsidyEntry : subsidyEntries
Declaration *-- "*" AssetEntry : assetEntries
Declaration *-- "*" BusinessParticipation : businessParticipations
Declaration *-- "*" Attachment : attachments

' ── Entries → shared domain ───────────────────────────────────────────────────
PositionEntry --> "1" Organization : organization
PositionEntry --> "1" PositionNature : nature

Income --> "1" Organization : organization

SubsidyEntry --> "1" Organization : organization

AssetEntry --> "1" AssetType : assetType
AssetEntry --> "0..1" RealEstate : realEstate
AssetEntry --> "0..1" VehicleAsset : vehicleAsset
AssetEntry --> "0..1" StockAsset : stockAsset

BusinessParticipation --> "1" Organization : organization

@enduml
