@startuml US06-SD
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Political\nAgent" as Agent
participant ":SubmitDeclarationUI" as UI
participant ":SubmitDeclarationController" as CTRL
participant ":Repositories" as REPOS
participant ":OrganizationRepository" as ORGR
participant ":DeclarationRepository" as DR
participant ":AuthenticationRepository" as AUTHR
participant ":PoliticalAgentRepository" as PAGR
participant "d:Declaration" as DEC

note over UI, REPOS
  On construction, SubmitDeclarationController calls
  Repositories.getInstance() and stores all four
  repository references as private final fields.
end note

UI -> CTRL ** : new SubmitDeclarationController()
activate CTRL
    CTRL -> REPOS : getInstance()
    activate REPOS
        REPOS --> CTRL : repos
    deactivate REPOS
    CTRL -> REPOS : getOrganizationRepository()
    activate REPOS
        REPOS --> CTRL : organizationRepository
    deactivate REPOS
    CTRL -> REPOS : getDeclarationRepository()
    activate REPOS
        REPOS --> CTRL : declarationRepository
    deactivate REPOS
    CTRL -> REPOS : getPoliticalAgentRepository()
    activate REPOS
        REPOS --> CTRL : politicalAgentRepository
    deactivate REPOS
    CTRL -> REPOS : getAuthenticationRepository()
    activate REPOS
        REPOS --> CTRL : authenticationRepository
    deactivate REPOS
deactivate CTRL

activate Agent

    Agent -> UI : asks to submit a new declaration of interests
    activate UI

        UI -> CTRL : getDeclarationTypes()
        activate CTRL
            CTRL --> UI : declarationTypes
        deactivate CTRL

        UI -> CTRL : getOrganizations()
        activate CTRL
            CTRL -> ORGR : getOrganizations()
            activate ORGR
                ORGR --> CTRL : organizations
            deactivate ORGR
            CTRL --> UI : organizations
        deactivate CTRL

        UI -> CTRL : getPositionNatures()
        activate CTRL
            CTRL --> UI : positionNatures
        deactivate CTRL

        UI -> CTRL : getAssetTypes()
        activate CTRL
            CTRL --> UI : assetTypes
        deactivate CTRL

        UI --> Agent : shows available options;\nrequests declaration data section by section
    deactivate UI

    Agent -> UI : provides type, position entries, subsidy entries,\nasset entries, business participations, attachments
    activate UI
        UI --> Agent : shows full declaration summary;\nrequests confirmation
    deactivate UI

    Agent -> UI : confirms submission
    activate UI

        UI -> CTRL : submitDeclaration(type, positionEntries,\nsubsidyEntries, assetEntries,\nbusinessParticipations, attachments)
        activate CTRL

            CTRL -> AUTHR : getCurrentUserSession()
            activate AUTHR
                AUTHR --> CTRL : userSession
            deactivate AUTHR

            CTRL -> AUTHR : userSession.getUserId()
            activate AUTHR
                AUTHR --> CTRL : email
            deactivate AUTHR

            CTRL -> PAGR : getByEmail(email)
            activate PAGR
                PAGR --> CTRL : agent
            deactivate PAGR

            CTRL -> DEC ** : new Declaration(type, agent, new Date())
            note right of DEC
                status initialised to PENDING
                inside the constructor
            end note

            loop for each positionEntry
                CTRL -> DEC : addPositionEntry(organization, functionDesignation,\nnature, grossSalary, sideIncomeConsulting,\nsideIncomeBoardMemberships, startDate, endDate)
            end

            loop for each subsidyEntry
                CTRL -> DEC : addSubsidyEntry(organization, amount, description, date)
            end

            loop for each assetEntry
                CTRL -> DEC : addAssetEntry(assetType, assetValue, detail)
            end

            loop for each businessParticipation
                CTRL -> DEC : addBusinessParticipation(organization,\ncompanyNIF, totalValueInStocks, companyPercentage)
            end

            loop for each attachment
                CTRL -> DEC : addAttachment(fileName, uploadDate)
            end

            CTRL -> DR : save(declaration)
            activate DR
                DR --> CTRL : true
            deactivate DR

            CTRL --> UI : true
        deactivate CTRL

        UI --> Agent : displays success message;\ndeclaration submitted with PENDING status
    deactivate UI

deactivate Agent

@enduml
