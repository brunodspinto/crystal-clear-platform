@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Political\nAgent" as Agent
participant ":System" as System

activate Agent

    Agent -> System : asks to submit a new declaration of interests
    activate System

        System --> Agent : shows declaration type list (initial, regular, exceptional)\nand asks to select one
    deactivate System

    Agent -> System : selects declaration type
    activate System

        System --> Agent : shows registered organizations and functions;\nrequests position entries (organization, function,\nnature, gross salary, side income, start date, end date)
    deactivate System

    Agent -> System : provides one or more position entries
    activate System

        System --> Agent : requests subsidy entries\n(source organization, description, amount, date)
    deactivate System

    Agent -> System : provides subsidy entries (or skips if none)
    activate System

        System --> Agent : requests asset entries\n(real estate: description, municipality, value;\nvehicles: value;\nstocks: value)
    deactivate System

    Agent -> System : provides asset entries (or skips if none)
    activate System

        System --> Agent : requests business participation (holdings) entries\n(company NIF, total value in stocks, company percentage)
    deactivate System

    Agent -> System : provides holdings entries (or skips if none)
    activate System

        System --> Agent : shows full declaration summary and requests confirmation
    deactivate System

    Agent -> System : confirms submission
    activate System

        System --> Agent : displays operation success;\ndeclaration set to "pending" state
    deactivate System

deactivate Agent

@enduml
