@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Citizen" as Citizen
participant ":System" as System

activate Citizen

    Citizen -> System : asks to make a complaint about a political agent
    activate System

        System --> Citizen : shows list of registered political agents\nand asks to select one
    deactivate System

    Citizen -> System : selects a political agent
    activate System

        System --> Citizen : asks for the first grievance
    deactivate System

    loop for each grievance about the same agent
        Citizen -> System : asks to add a grievance
        activate System
            System --> Citizen : shows list of political functions\nand asks to select one
        deactivate System

        Citizen -> System : selects a political function
        activate System
            System --> Citizen : requests the complaint date and description
        deactivate System

        Citizen -> System : types the complaint date and description
        activate System
            System --> Citizen : shows grievance summary and requests confirmation
        deactivate System

        Citizen -> System : confirms the grievance
        activate System
            System --> Citizen : asks to add another grievance\nabout the same agent
        deactivate System
    end

    Citizen -> System : submits the complaint
    activate System

        System --> Citizen : displays operation success
    deactivate System

deactivate Citizen

@enduml
