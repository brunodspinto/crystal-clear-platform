@startuml US12-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Citizen" as C
participant ":SubmitComplaintUI" as UI
participant ":SubmitComplaintController" as CTRL
participant "Repositories" as REPOS
participant ":PoliticalAgentRepository" as PAR
participant ":AuthenticationRepository" as AR
participant "session:UserSession" as SESS
participant "email:Email" as EML
participant ":CitizenRepository" as CitR
participant ":ComplaintRepository" as CR
participant "cpl:Complaint" as CPL
participant "item:ComplaintItem" as ITM

activate C

    C -> UI : requests to submit a complaint
    activate UI

        UI -> CTRL** : create
        activate CTRL
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS
            CTRL -> REPOS : getPoliticalAgentRepository()
            activate REPOS
                REPOS --> CTRL : politicalAgentRepository
            deactivate REPOS
            CTRL -> REPOS : getCitizenRepository()
            activate REPOS
                REPOS --> CTRL : citizenRepository
            deactivate REPOS
            CTRL -> REPOS : getComplaintRepository()
            activate REPOS
                REPOS --> CTRL : complaintRepository
            deactivate REPOS
            CTRL -> REPOS : getAuthenticationRepository()
            activate REPOS
                REPOS --> CTRL : authenticationRepository
            deactivate REPOS
        deactivate CTRL

        UI -> CTRL : getPoliticalAgents()
        activate CTRL
            CTRL -> PAR : getAll()
            activate PAR
                PAR --> CTRL : politicalAgentList
            deactivate PAR
            CTRL --> UI : politicalAgentList
        deactivate CTRL

        UI --> C : shows list of political agents\nand asks to select one
    deactivate UI

    C -> UI : selects political agent
    activate UI

        UI -> CTRL : createComplaint(politicalAgent)
        activate CTRL
            CTRL -> AR : getCurrentUserSession()
            activate AR
                AR --> CTRL : session
            deactivate AR
            CTRL -> SESS : getUserId()
            activate SESS
                SESS --> CTRL : email
            deactivate SESS
            CTRL -> EML : getEmail()
            activate EML
                EML --> CTRL : emailAddress
            deactivate EML
            CTRL -> CitR : getCitizenByEmail(emailAddress)
            activate CitR
                CitR --> CTRL : citizen
            deactivate CitR
            CTRL -> CPL ** : new Complaint(citizen, politicalAgent)
            CTRL --> UI : complaint
        deactivate CTRL
    deactivate UI

    loop for each grievance about the same agent
        UI -> CTRL : getPoliticalFunctions()
        activate UI
        activate CTRL
            CTRL --> UI : politicalFunctionList
        deactivate CTRL
        UI --> C : shows list of political functions\nand requests description and date
        deactivate UI

        C -> UI : selects function, types description and date
        activate UI
            UI --> C : shows grievance summary and requests confirmation
        deactivate UI

        C -> UI : confirms grievance
        activate UI
            UI -> CTRL : addGrievance(complaint, description, date, function)
            activate CTRL
                CTRL -> CPL : addItem(description, date, function)
                activate CPL
                    CPL -> ITM ** : new ComplaintItem(description, date, function)
                deactivate CPL
            deactivate CTRL
            UI --> C : asks whether to add another grievance
        deactivate UI
    end

    C -> UI : finishes (no more grievances)
    activate UI
        UI -> CTRL : saveComplaint(complaint)
        activate CTRL
            CTRL -> CR : save(complaint)
            activate CR
                CR --> CTRL : success
            deactivate CR
            CTRL --> UI : success
        deactivate CTRL
        UI --> C : displays operation success
    deactivate UI

deactivate C

@enduml
