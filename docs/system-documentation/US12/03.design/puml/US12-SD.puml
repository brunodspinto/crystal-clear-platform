@startuml US12-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Citizen" as C
participant ":SubmitComplaintUI" as UI
participant ":SubmitComplaintController" as CTRL
participant "Repositories" as REPOS
participant ":PoliticalAgentMapper" as PAM
participant ":PoliticalAgentRepository" as PAR
participant ":AuthenticationRepository" as AR
participant "session:UserSession" as SESS
participant ":CitizenRepository" as CitR
participant ":ComplaintRepository" as CR
participant "cpl:Complaint" as CPL

activate C

    C -> UI : requests to submit a complaint
    activate UI

        UI -> CTRL** : create
        activate CTRL
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS
            CTRL -> REPOS : getPoliticalAgentRepository()
            activate REPOS
                REPOS --> CTRL : politicalAgentRepository
            deactivate REPOS
            CTRL -> REPOS : getCitizenRepository()
            activate REPOS
                REPOS --> CTRL : citizenRepository
            deactivate REPOS
            CTRL -> REPOS : getComplaintRepository()
            activate REPOS
                REPOS --> CTRL : complaintRepository
            deactivate REPOS
            CTRL -> REPOS : getAuthenticationRepository()
            activate REPOS
                REPOS --> CTRL : authenticationRepository
            deactivate REPOS
        deactivate CTRL

        UI -> CTRL : getPoliticalAgents()
        activate CTRL
            CTRL -> PAR : getAll()
            activate PAR
                PAR --> CTRL : politicalAgentList
            deactivate PAR
            CTRL -> PAM : toDTO(politicalAgentList)
            activate PAM
                PAM --> CTRL : agentDtoList
            deactivate PAM
            CTRL --> UI : agentDtoList
        deactivate CTRL

        UI --> C : shows list of agents (DTO)\nand asks to select one
    deactivate UI

    C -> UI : selects a political agent (DTO)
    activate UI

        UI -> CTRL : startComplaint(agentDto)
        activate CTRL
            ref over CTRL, AR, SESS, CitR
                obtain the authenticated citizen
                (session -> email -> CitizenRepository)
            end ref
            CTRL -> PAR : getByEmail(agentDto.email)
            activate PAR
                PAR --> CTRL : politicalAgent
            deactivate PAR
            CTRL -> CPL ** : new Complaint(citizen, politicalAgent)
            CTRL --> UI : true
        deactivate CTRL
    deactivate UI

    loop for each grievance about the same agent
        UI -> CTRL : getPoliticalFunctions()
        activate UI
        activate CTRL
            CTRL --> UI : politicalFunctionList
        deactivate CTRL
        UI --> C : shows functions and requests description and date
        deactivate UI

        C -> UI : selects function, types description and date, confirms
        activate UI
            UI -> CTRL : addGrievance(description, date, function)
            activate CTRL
                CTRL -> CPL : addItem(description, date, function)
            deactivate CTRL
            UI --> C : asks whether to add another grievance
        deactivate UI
    end

    C -> UI : submits the complaint
    activate UI
        UI -> CTRL : submitComplaint()
        activate CTRL
            CTRL -> CR : save(cpl)
            activate CR
                CR --> CTRL : success
            deactivate CR
            CTRL --> UI : success
        deactivate CTRL
        UI --> C : displays operation success
    deactivate UI

deactivate C

@enduml
