@startuml US04-CD
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class RegisterOrganizationUI {
}

class RegisterOrganizationController {
    + RegisterOrganizationController()
    + getOrganizationTypes() : List<OrganizationType>
    + getOrganizationNatures() : List<OrganizationNature>
    + registerOrganization(name : String, nature : OrganizationNature, type : OrganizationType) : boolean
}

class Repositories <<Singleton>> {
    - {static} instance : Repositories
    - Repositories()
    + {static} getInstance() : Repositories
    + getOrganizationRepository() : OrganizationRepository
}

class OrganizationRepository {
    + save(organization : Organization) : boolean
    + existsByNameAndType(name : String, type : OrganizationType) : boolean
}

class Organization {
    - name : String
    - nature : OrganizationNature
    + Organization(name : String, nature : OrganizationNature, type : OrganizationType)
    + getName() : String
    + getNature() : OrganizationNature
    + getType() : OrganizationType
}

enum OrganizationType {
    COMPANY
    POLITICAL_PARTY
    FOUNDATION
    INSTITUTE
    ASSOCIATION
}

enum OrganizationNature {
    PUBLIC
    PRIVATE
    SOCIAL
}

RegisterOrganizationUI .> RegisterOrganizationController

RegisterOrganizationController ..> Repositories
RegisterOrganizationController ..> OrganizationRepository
RegisterOrganizationController ..> Organization

Repositories -> "1" Repositories : instance
Repositories --> "1" OrganizationRepository : organizationRepository

OrganizationRepository "1" --> "*" Organization : organizations

Organization ..> OrganizationType
Organization ..> OrganizationNature

@enduml
