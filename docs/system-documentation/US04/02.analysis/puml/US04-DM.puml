@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

title Domain Model Excerpt - US04

class Administrator {
    name
    email
}

class Organization {
    name
}

enum OrganizationType {
    company
    politicalParty
    foundation
    institute
    association
}

Administrator "1" -- "*" Organization : registers >

Organization "*" -- "1" OrganizationType : classified as

@enduml
