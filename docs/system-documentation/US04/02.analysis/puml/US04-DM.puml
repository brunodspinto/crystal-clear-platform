@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

hide circle
hide methods

title Domain Model Excerpt - US04

class Administrator {
}

class Institution {
    - name
    - nature
}

class InstitutionType {
    - designation
}

enum InstitutionNature {
    PUBLIC
    PRIVATE
    SOCIAL
}

Administrator "1" -- "*" Institution : registers >
Institution "*" -- "1" InstitutionType : has >
Institution "*" -- "1" InstitutionNature : classified as >

@enduml