@startuml US03-SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Political Agent" as PA
participant ":ListOrganizationsUI" as UI
participant ":ListOrganizationsController" as CTRL
participant "Repositories" as REPOS
participant "repositories:Repositories" as REPOS_SINGLETON
participant ":OrganizationRepository" as REPO
participant ":OrganizationMapper" as MAPPER
participant "dto:OrganizationDTO" as DTO

activate PA

    PA -> UI : asks to list institutions
    activate UI

        UI --> CTRL** : create()
        activate CTRL
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS

            CTRL -> REPOS_SINGLETON : getOrganizationRepository()
            activate REPOS_SINGLETON
                REPOS_SINGLETON --> CTRL : organizationRepository
            deactivate REPOS_SINGLETON

            CTRL --> MAPPER** : create()
        deactivate CTRL

        UI -> CTRL : getOrganizationsGroupedByType()
        activate CTRL

            CTRL -> REPO : getOrganizations()
            activate REPO
                REPO --> CTRL : organizations
            deactivate REPO

            note right of CTRL
                groups organizations by type and
                sorts alphabetically within each group
            end note

            loop for each group of organizations
                CTRL -> MAPPER : toDTO(organizations)
                activate MAPPER
                    loop for each organization
                        MAPPER --> DTO** : new OrganizationDTO(name,\ntypeDesignation, natureDesignation)
                    end
                    MAPPER --> CTRL : organizationDTOs
                deactivate MAPPER
            end

            CTRL --> UI : grouped (Map<OrganizationType, List<OrganizationDTO>>)
        deactivate CTRL

        UI --> PA : displays institutions grouped by type,\nsorted alphabetically within each group
    deactivate UI

deactivate PA

@enduml
