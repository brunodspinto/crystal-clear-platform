@startuml US03-CD
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class ListOrganizationsUI {
}

class ListOrganizationsController {
    + ListOrganizationsController()
    + getOrganizationsGroupedByType() : Map<OrganizationType, List<OrganizationDTO>>
}

class OrganizationMapper {
    + toDTO(organization : Organization) : OrganizationDTO
    + toDTO(organizations : List<Organization>) : List<OrganizationDTO>
}

class OrganizationDTO {
    - name : String
    - typeDesignation : String
    - natureDesignation : String
    + getName() : String
    + getTypeDesignation() : String
    + getNatureDesignation() : String
}

class OrganizationRepository {
    + getOrganizations() : List<Organization>
}

class Repositories {
    - Repositories()
    + {static} getInstance() : Repositories
    + getOrganizationRepository() : OrganizationRepository
}

class Organization {
    - name : String
    - type : OrganizationType
    - nature : OrganizationNature
    + getName() : String
    + getType() : OrganizationType
    + getNature() : OrganizationNature
}

enum OrganizationType {
    COMPANY
    POLITICAL_PARTY
    FOUNDATION
    INSTITUTE
    ASSOCIATION
}

enum OrganizationNature {
    PUBLIC
    PRIVATE
    SOCIAL
}

ListOrganizationsUI .> ListOrganizationsController
ListOrganizationsUI ..> OrganizationDTO
ListOrganizationsUI ..> OrganizationType
ListOrganizationsController --> "1" OrganizationMapper : organizationMapper
OrganizationMapper ..> OrganizationDTO : creates
OrganizationMapper ..> Organization
ListOrganizationsController .> Repositories
ListOrganizationsController ..> OrganizationRepository
Repositories -> "1" Repositories : instance
Repositories --> "1" OrganizationRepository : organizationRepository
OrganizationRepository "1" --> "*" Organization : stores
Organization "1" --> "1" OrganizationType : type
Organization "1" --> "1" OrganizationNature : nature

@enduml
