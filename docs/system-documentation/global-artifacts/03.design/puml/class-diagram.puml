@startuml class-diagram
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle

package "pt.ipp.isep.dei.domain" {

    ' -- user hierarchy ----------------------------------------------------
    abstract class User {
        # name
        # email
        + getName()
        + getEmail()
        + hasEmail(email)
    }

    class PoliticalAgent {
        - nationalIdentityCard
        - taxIdentificationNumber {id}
        - mandateStart
        - mandateEnd
        + getNationalIdentityCard()
        + getTaxIdentificationNumber()
    }

    class Citizen {
        - nationalIdCardNumber
        + getNationalIdCardNumber()
    }

    class EthicsCommitteeMember {
    }

    User <|-- PoliticalAgent
    User <|-- Citizen
    User <|-- EthicsCommitteeMember

    ' -- registration ------------------------------------------------------
    class RegistrationRequest {
        - fullName
        - email
        - password
        - identificationDocument
        - submissionDate
        - status
        - rejectionReason
        + approve()
        + reject(reason)
        + getRole()
        + getStatus()
    }

    enum UserRole <<enumeration>> {
        POLITICAL_AGENT
        CITIZEN
        JOURNALIST
        ETHICS_COMMITTEE
        ADMINISTRATOR
    }

    enum RegistrationStatus <<enumeration>> {
        PENDING
        APPROVED
        REJECTED
    }

    RegistrationRequest --> UserRole : requestedRole
    RegistrationRequest --> RegistrationStatus : hasStatus

    ' -- complaint ---------------------------------------------------------
    class Complaint {
        - submissionDate
        + addItem(description, date, function)
        + getItems()
        + getCitizen()
        + getPoliticalAgent()
    }

    class ComplaintItem {
        - description
        - complaintDate
        + getDescription()
        + getComplaintDate()
        + getPoliticalFunction()
    }

    enum PoliticalFunction <<enumeration>> {
        MINISTER
        DEPUTY
        COUNCILLOR
        PARISH_COUNCIL_PRESIDENT
        MAYOR
    }

    Citizen "1" -- "0..*" Complaint : submits
    Complaint "0..*" -- "1" PoliticalAgent : targets
    Complaint "1" *-- "1..*" ComplaintItem : items
    ComplaintItem "0..*" -- "1" PoliticalFunction : references

    ' -- complaint assessment (US27) --------------------------------------
    class ComplaintAssessment {
        - assessmentDate
        - reason
        + getOutcome()
        + getReason()
        + getComplaint()
    }

    enum ComplaintOutcome <<enumeration>> {
        VALID
        INVALID
    }

    EthicsCommitteeMember "1" -- "0..*" ComplaintAssessment : performs
    ComplaintAssessment "0..*" -- "1" Complaint : assesses
    ComplaintAssessment --> ComplaintOutcome : hasOutcome

    ' -- declaration aggregate --------------------------------------------
    class Declaration {
        - id
        - submissionDate
        + getId()
        + getType()
        + getStatus()
        + setStatus(status)
        + addPositionEntry(...)
        + addIncome(...)
        + addSubsidyEntry(...)
        + addAssetEntry(...)
        + addBusinessParticipation(...)
        + addAttachment(...)
        + getPositionEntries()
        + getIncomes()
        + getSubsidyEntries()
        + getAssetEntries()
        + getBusinessParticipations()
    }

    enum DeclarationType <<enumeration>> {
        INITIAL
        REGULAR
        EXCEPTIONAL
    }

    enum DeclarationStatus <<enumeration>> {
        PENDING
        VALIDATED
        REJECTED
    }

    class PositionEntry {
        - functionDesignation
        - grossSalary
        - sideIncomeConsulting
        - sideIncomeBoardMemberships
        - startDate
        - endDate
        + getOrganization()
        + getNature()
    }

    class Income {
        - amount
        - source
        - date
        + getOrganization()
        + getAmount()
        + getSource()
        + getDate()
    }

    class SubsidyEntry {
        - amount
        - description
        - date
        + getOrganization()
        + getAmount()
    }

    class AssetEntry {
        - assetValue
        + getAssetType()
        + getAssetValue()
        + getRealEstate()
        + getVehicleAsset()
        + getStockAsset()
    }

    class BusinessParticipation {
        - companyNIF
        - totalValueInStocks
        - companyPercentage
        + getOrganization()
        + getCompanyNIF()
    }

    class Attachment {
        - fileName
        - uploadDate
        + getFileName()
        + getUploadDate()
    }

    enum PositionNature <<enumeration>> {
        PUBLIC
        PRIVATE
        SOCIAL
    }

    enum AssetType <<enumeration>> {
        REAL_ESTATE
        VEHICLES
        STOCKS
    }

    PoliticalAgent "1" -- "0..*" Declaration : submits
    Declaration --> DeclarationType : classifiedAs
    Declaration --> DeclarationStatus : hasStatus
    Declaration "1" *-- "0..*" PositionEntry : positions
    Declaration "1" *-- "0..*" Income : incomes
    Declaration "1" *-- "0..*" SubsidyEntry : subsidies
    Declaration "1" *-- "0..*" AssetEntry : assets
    Declaration "1" *-- "0..*" BusinessParticipation : participations
    Declaration "1" *-- "0..*" Attachment : attachments

    PositionEntry "0..*" --> "1" Organization : heldAt
    PositionEntry --> PositionNature : nature
    Income "0..*" --> "1" Organization : paidBy
    SubsidyEntry "0..*" --> "1" Organization : receivedFrom
    BusinessParticipation "0..*" --> "1" Organization : heldIn

    ' -- asset detail classes ({xor}: exactly one is non-null) ------------
    class RealEstate {
        - description
        - municipality
        + getDescription()
        + getMunicipality()
    }

    class VehicleAsset {
        - description
        + getDescription()
    }

    class StockAsset {
        - description
        + getDescription()
    }

    AssetEntry --> AssetType : classifiedAs
    AssetEntry "1" o-- "0..1" RealEstate : detail
    AssetEntry "1" o-- "0..1" VehicleAsset : detail
    AssetEntry "1" o-- "0..1" StockAsset : detail
    note "{xor}\nexactly one detail\nper AssetType" as XOR
    RealEstate . XOR
    VehicleAsset . XOR
    StockAsset . XOR

    ' -- validation (US08) ------------------------------------------------
    class ValidationRecord {
        - validationDate
        + getMember()
        + getDeclaration()
        + getOutcome()
        + getComments()
    }

    class ValidationComment {
        - section
        - comment
        + getSection()
        + getComment()
    }

    enum ValidationOutcome <<enumeration>> {
        VALIDATED
        RETURNED_FOR_CORRECTION
    }

    class EthicsCommittee {
        - name
        + getName()
        + getMembers()
        + addMember(member)
    }

    EthicsCommittee "1" *-- "0..*" EthicsCommitteeMember : composedOf
    ValidationRecord "0..*" --> "1" EthicsCommitteeMember : signedBy
    ValidationRecord "0..*" --> "1" Declaration : reviews
    ValidationRecord --> ValidationOutcome : hasOutcome
    ValidationRecord "1" *-- "0..*" ValidationComment : comments

    ' -- organisation -----------------------------------------------------
    class Organization {
        - vatNumber
        - name
        - nature
        - website
        - phone
        - email
        + getName()
        + getType()
        + addEmployee(employee)
    }

    class Employee {
        - email
        - name
        - position
        - phone
        + hasEmail(email)
    }

    enum OrganizationType <<enumeration>> {
        COMPANY
        POLITICAL_PARTY
        FOUNDATION
        INSTITUTE
        ASSOCIATION
    }

    enum OrganizationNature <<enumeration>> {
        PUBLIC
        PRIVATE
        SOCIAL
    }

    Organization --> OrganizationType : classifiedAs
    Organization --> OrganizationNature : hasNature
    Organization "1" *-- "0..*" Employee : employs

    ' -- utility ----------------------------------------------------------
    class DeclarationCsvExporter <<utility>> {
        + {static} export(declarations, filePath)
    }

    DeclarationCsvExporter ..> Declaration : exports
}

@enduml
