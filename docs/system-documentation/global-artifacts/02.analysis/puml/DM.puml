@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

title Domain Model - Portal de Transparência

class User {
    fullName
    email
}

class RegistrationRequest {
    fullName
    email
    password
    identificationDocument
    status
    submissionDate
}

class RejectionReason {
    description
}

enum Status {
    PENDING
    APPROVED
    REJECTED
}

enum Role {
    POLITICAL_AGENT
    ORDINARY_CITIZEN
    JOURNALIST
    ETHICS_COMMITTEE
    SYSTEM_ADMINISTRATOR
}

class Administrator {
}

class Citizen {
    nationalIdCardNumber
}

class Journalist {
    phone
    pressCardNumber
}

class "Ethics Committee Member" as EthicsCommitteeMember {
}

class "Ethics Committee" as EthicsCommittee {
}

class "Political Agent" as PoliticalAgent {
    nationalIdentityCard
    taxIdentificationNumber
    mandateStart
    mandateEnd
}

enum PoliticalFunction {
    minister
    deputy
    councillor
    parishCouncilPresident
    mayor
}

class Function {
    designation
}

class Institution {
    name
    type
}

class "Declaration of Interests" as Declaration {
    name
    submissionDate
}

enum DeclarationType {
    INITIAL
    REGULAR
    EXCEPTIONAL
}

enum DeclarationStatus {
    PENDING
    VALIDATED
    REJECTED
}

class PositionEntry {
    nature
    remuneration
    startDate
    endDate
}

class Income {
    amount
    source
    date
}

class SubsidyEntry {
    amount
    description
    date
}

class Asset {
    acquisitionValue
    marketValue
}

enum AssetType {
    URBAN
    RURAL
}

class "Real Estate" as RealEstate {
    description
    municipality
}

class BusinessParticipation {
    numberOfShares
    marketValue
}

class AuditLog {
    action
    timestamp
    details
}

class ValidationRecord {
    validationDate
}

enum ValidationOutcome {
    VALIDATED
    RETURNED_FOR_CORRECTION
}

class ValidationComment {
    section
    comment
}

class Complaint {
    description
    complaintDate
    submissionDate
}

class Attachment {
    fileName
    fileType
    uploadDate
}

User <|-- Administrator
User <|-- Citizen
User <|-- Journalist
User <|-- EthicsCommitteeMember
User <|-- PoliticalAgent

RegistrationRequest "1" -- "1" Role : requests >
RegistrationRequest "1" -- "1" Status : has >
RegistrationRequest ..> User : results in / activates >
Administrator "*" -- "*" RegistrationRequest : reviews >
RegistrationRequest "1" -- "0..1" RejectionReason : has >
RegistrationRequest "0..1" -- "0..1" Function : specifies >
RegistrationRequest "0..1" -- "0..1" Institution : specifies >

EthicsCommitteeMember "*" -- "1" EthicsCommittee : belongs to >

Administrator "*" -- "*" Institution : registers >
Administrator "*" -- "*" Function : registers >

PoliticalAgent "1" -- "*" PoliticalFunction : has >
PoliticalAgent "1" -- "*" Declaration : submits / has >

Declaration "*" -- "1" DeclarationType : classified as >
Declaration "*" -- "1" DeclarationStatus : has >

Declaration "1" *-- "*" PositionEntry : includes >
Declaration "1" *-- "*" Income : includes >
Declaration "1" *-- "*" SubsidyEntry : includes >
Declaration "1" *-- "*" Asset : includes >
Declaration "1" *-- "*" BusinessParticipation : includes >
Declaration "1" *-- "*" Attachment : has >

PositionEntry "*" -- "1" Institution : held at >
PositionEntry "*" -- "1" Function : performs >

SubsidyEntry "*" -- "1" Institution : received from >
Income "*" -- "1" Institution : received from >

Asset "*" -- "1" AssetType : classified as >
Asset "1" -- "1" RealEstate : described by >

BusinessParticipation "*" -- "1" Institution : held in >

EthicsCommitteeMember "1" -- "*" ValidationRecord : performs >
ValidationRecord "*" -- "1" Declaration : concerns >
ValidationRecord "*" -- "1" ValidationOutcome : results in >
ValidationRecord "1" *-- "*" ValidationComment : contains >

Citizen "1" -- "*" Complaint : submits >
Complaint "*" -- "1" PoliticalAgent : targets >
Complaint "*" -- "1" PoliticalFunction : references >

User "1" -- "*" AuditLog : generates >

@enduml
