@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

title Domain Model - Portal de Transparência

class User {
    fullName
    email
}

class RegistrationRequest {
    fullName
    email
    password
    identificationDocument
    status
    submissionDate
}

class RejectionReason {
    description
}

enum Status {
    PENDING
    APPROVED
    REJECTED
}

enum Role {
    POLITICAL_AGENT
    ORDINARY_CITIZEN
    JOURNALIST
    ETHICS_COMMITTEE
    SYSTEM_ADMINISTRATOR
    PRODUCT_OWNER
}

class Administrator {
}

class "Product Owner" as ProductOwner {
}

class Citizen {
    nationalIdCardNumber
}

class Journalist {
    phone
    pressCardNumber
}

class "Ethics Committee Member" as EthicsCommitteeMember {
}

class "Ethics Committee" as EthicsCommittee {
}

class "Political Agent" as PoliticalAgent {
    nationalIdentityCard
    taxIdentificationNumber
    mandateStart
    mandateEnd
}

enum PoliticalFunction {
    MINISTER
    DEPUTY
    COUNCILLOR
    PARISH_COUNCIL_PRESIDENT
    MAYOR
}

class Function {
    designation
}

class Organization {
    name
    nature
}

enum OrganizationType {
    COMPANY
    POLITICAL_PARTY
    FOUNDATION
    INSTITUTE
    ASSOCIATION
}

enum OrganizationNature {
    PUBLIC
    PRIVATE
    SOCIAL
}

class "Declaration of Interests" as Declaration {
    id
    submissionDate
}

enum DeclarationType {
    INITIAL
    REGULAR
    EXCEPTIONAL
}

enum DeclarationStatus {
    PENDING
    VALIDATED
    REJECTED
}

class HouseholdMember {
    name
}
enum HouseholdRelation {
    SPOUSE
    DESCENDANT
    OTHER
}
class PositionEntry {
    grossSalary
    sideIncomeConsulting
    sideIncomeBoardMemberships
    startDate
    endDate
}

enum PositionNature {
    PUBLIC
    PRIVATE
    SOCIAL
}

class Income {
    amount
    source
    institution
    date
}

class SubsidyEntry {
    amount
    description
    date
}

class AssetEntry {
    assetValue
}

enum AssetType {
    REAL_ESTATE
    VEHICLES
    STOCKS
}

class "Real Estate" as RealEstate {
    description
    municipality
}

class VehicleAsset {
    description
}

class StockAsset {
    description
}

class BusinessParticipation {
    companyNIF
    totalValueInStocks
    companyPercentage
}


class ValidationRecord {
    validationDate
}

enum ValidationOutcome {
    VALIDATED
    RETURNED_FOR_CORRECTION
}

class ValidationComment {
    section
    comment
}

class Complaint {
    submissionDate
}
class ComplaintItem {
    description
    complaintDate
}

class ComplaintAssessment {
    assessmentDate
    reason
}

enum ComplaintOutcome {
    VALID
    INVALID
}

class Attachment {
    fileName
    uploadDate
}

class Entity {
    startDate
    endDate
}

enum EntityType {
    PERSON
    ORGANIZATION
    POSITION
    ASSET
}

class "graph.Person" as GraphPerson {
    name
    birthDate
    nationality
}

class "graph.Organization" as GraphOrganization {
    name
    organizationType
    country
}

class "graph.Position" as GraphPosition {
    positionTitle
    positionType
    organizationId
}

class "graph.Asset" as GraphAsset {
    assetType
    country
    estimatedValue
}

class EntityRelationship {
    type
    startDate
    endDate
    weight
}

enum RelationshipType {
    RELATIVE_OF
    FRIEND_OF
    ASSOCIATED_WITH
    APPOINTED_BY
    HOLDS_POSITION
    IN_ORGANIZATION
    MEMBER_OF
    SUPPORTS
    OPPOSES
    INFLUENCES
    CONTROLS
    PARTNER_OF
    SUPERVISES
    OWNER_OF
}

enum FamilyRelationshipType {
    SPOUSE_OF
    SIBLING_OF
    PARENT_OF
    CHILD_OF
    GRANDPARENT_OF
    GRANDCHILD_OF
}

User <|-- Administrator
User <|-- Citizen
User <|-- Journalist
User <|-- EthicsCommitteeMember
User <|-- PoliticalAgent
User <|-- ProductOwner

RegistrationRequest "1" -- "1" Role : requests >
RegistrationRequest "1" -- "1" Status : has >
RegistrationRequest ..> User : results in / activates >
Administrator "1" -- "*" RegistrationRequest : reviews >
RegistrationRequest "1" -- "0..1" RejectionReason : has >
RegistrationRequest "0..1" -- "0..1" Function : specifies >
RegistrationRequest "0..1" -- "0..1" Organization : specifies >

EthicsCommitteeMember "*" -- "1" EthicsCommittee : belongs to >

Administrator "1" -- "*" Organization : registers >
Administrator "*" -- "*" Function : registers >

PoliticalAgent "1" -- "*" PoliticalFunction : has >
PoliticalAgent "1" -- "*" Declaration : submits / has >

Declaration "*" -- "1" DeclarationType : classified as >
Declaration "*" -- "1" DeclarationStatus : has >

Declaration "1" *-- "*" HouseholdMember : declares >
HouseholdMember "*" -- "1" HouseholdRelation : related as >
Declaration "1" *-- "*" PositionEntry : includes >
Declaration "1" *-- "*" Income : includes >
Declaration "1" *-- "*" SubsidyEntry : includes >
Declaration "1" *-- "*" AssetEntry : includes >
Declaration "1" *-- "*" BusinessParticipation : includes >
Declaration "1" *-- "*" Attachment : has >

PositionEntry "*" -- "1" Organization : held at >
PositionEntry "*" -- "1" Function : performs >
PositionEntry "*" -- "1" PositionNature : has >

Organization "*" -- "1" OrganizationType : classified as >
Organization "*" -- "1" OrganizationNature : has nature >

SubsidyEntry "*" -- "1" Organization : received from >
Income "*" -- "1" Organization : received from >

AssetEntry "*" -- "1" AssetType : classified as >
AssetEntry "1" -- "0..1" RealEstate : described by >
AssetEntry "1" -- "0..1" VehicleAsset : described by >
AssetEntry "1" -- "0..1" StockAsset : described by >

BusinessParticipation "*" -- "1" Organization : held in >

EthicsCommitteeMember "1" -- "*" ValidationRecord : performs >
ValidationRecord "*" -- "1" Declaration : concerns >
ValidationRecord "*" -- "1" ValidationOutcome : results in >
ValidationRecord "1" *-- "*" ValidationComment : contains >

Citizen "1" -- "*" Complaint : submits >
Complaint "*" -- "1" PoliticalAgent : targets >
Complaint "1" *-- "*" ComplaintItem : contains >
ComplaintItem "*" -- "1" PoliticalFunction : references >

EthicsCommitteeMember "1" -- "*" ComplaintAssessment : performs >
ComplaintAssessment "*" -- "1" Complaint : assesses >
ComplaintAssessment "*" -- "1" ComplaintOutcome : results in >

Journalist "*" -- "*" PoliticalAgent : analyses income of >
Journalist "*" -- "*" PoliticalAgent : consults assets of >
Citizen "*" -- "*" PoliticalAgent : consults assets of >


Entity "*" -- "1" EntityType : classified as >
Entity <|-- GraphPerson
Entity <|-- GraphOrganization
Entity <|-- GraphPosition
Entity <|-- GraphAsset

EntityRelationship "*" -- "1" Entity : entity1 >
EntityRelationship "*" -- "1" Entity : entity2 >
EntityRelationship "*" -- "1" RelationshipType : of type >
EntityRelationship "*" -- "0..1" FamilyRelationshipType : inferred as (family, US37) >

ProductOwner "1" -- "*" Entity : imports >
ProductOwner "1" -- "*" EntityRelationship : imports >
ProductOwner "1" -- "*" Declaration : exports (CSV) >

@enduml
