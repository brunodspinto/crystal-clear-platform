@startuml US08-SD
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Ethics Committee\nMember" as Member
participant ":ValidateDeclarationUI" as UI
participant ":ValidateDeclarationController" as CTRL
participant ":DeclarationMapper" as MAPPER
participant ":Repositories" as REPOS
participant ":DeclarationRepository" as DR
participant ":ValidationRecordRepository" as VRR
participant ":EthicsCommitteeMemberRepository" as ECMR
participant ":AuthenticationRepository" as AUTHR
participant "d:Declaration" as DEC
participant "vr:ValidationRecord" as VR

note over UI, REPOS
  On construction, ValidateDeclarationController calls
  Repositories.getInstance() and stores all four
  repository references as private final fields.
end note

UI -> CTRL ** : new ValidateDeclarationController()
activate CTRL
    CTRL -> REPOS : getInstance()
    activate REPOS
        REPOS --> CTRL : repos
    deactivate REPOS
    CTRL -> REPOS : getDeclarationRepository()
    activate REPOS
        REPOS --> CTRL : declarationRepository
    deactivate REPOS
    CTRL -> REPOS : getValidationRecordRepository()
    activate REPOS
        REPOS --> CTRL : validationRecordRepository
    deactivate REPOS
    CTRL -> REPOS : getEthicsCommitteeMemberRepository()
    activate REPOS
        REPOS --> CTRL : ethicsCommitteeMemberRepository
    deactivate REPOS
    CTRL -> REPOS : getAuthenticationRepository()
    activate REPOS
        REPOS --> CTRL : authenticationRepository
    deactivate REPOS
deactivate CTRL

activate Member

    Member -> UI : asks to validate a declaration of interests
    activate UI

        UI -> CTRL : getPendingDeclarations()
        activate CTRL
            CTRL -> DR : getDeclarationsByStatus(PENDING)
            activate DR
                DR --> CTRL : declarations
            deactivate DR
            CTRL -> MAPPER : toDTO(declarations)
            activate MAPPER
                MAPPER --> CTRL : pendingDtos
            deactivate MAPPER
            CTRL --> UI : pendingDtos
        deactivate CTRL

        UI --> Member : shows list of pending declarations (DTOs)
    deactivate UI

    Member -> UI : selects a declaration to review
    activate UI

        UI -> CTRL : getDeclarationDetails(dto.getId())
        activate CTRL
            CTRL -> DR : getById(declarationId)
            activate DR
                DR --> CTRL : d
            deactivate DR
            CTRL -> DEC : getDetails()
            activate DEC
                DEC --> CTRL : detailsString
            deactivate DEC
            CTRL --> UI : detailsString
        deactivate CTRL

        UI -> CTRL : getValidationOutcomes()
        activate CTRL
            CTRL --> UI : validationOutcomes
        deactivate CTRL

        UI --> Member : displays full declaration content\nand requests validation outcome
    deactivate UI

    Member -> UI : selects outcome;\nprovides comments if rejecting
    activate UI

        UI -> CTRL : processValidation(dto.getId(), outcome, comments)
        activate CTRL

            CTRL -> DR : getById(declarationId)
            activate DR
                DR --> CTRL : d
            deactivate DR

            note right of CTRL
                AC3: guard — if the id is unknown or
                declaration.status != PENDING,
                return false immediately
            end note

            CTRL -> AUTHR : getCurrentUserSession()
            activate AUTHR
                AUTHR --> CTRL : userSession
            deactivate AUTHR

            CTRL -> AUTHR : userSession.getUserId()
            activate AUTHR
                AUTHR --> CTRL : email
            deactivate AUTHR

            CTRL -> ECMR : getByEmail(email)
            activate ECMR
                ECMR --> CTRL : member
            deactivate ECMR

            CTRL -> DEC : setStatus(outcome)

            CTRL -> DR : save(declaration)
            activate DR
                DR --> CTRL : true
            deactivate DR

            CTRL -> VR ** : new ValidationRecord(member, declaration, new Date(), outcome)

            alt outcome == RETURNED_FOR_CORRECTION
                loop for each comment
                    CTRL -> VR : addComment(section, comment)
                end
            end

            CTRL -> VRR : save(vr)
            activate VRR
                VRR --> CTRL : true
            deactivate VRR

            CTRL --> UI : true
        deactivate CTRL

        alt outcome == VALIDATED
            UI --> Member : declaration status set to VALIDATED
        else outcome == RETURNED_FOR_CORRECTION
            UI --> Member : declaration status set to REJECTED;\nreturned for correction with comments
        end
    deactivate UI

deactivate Member

@enduml
