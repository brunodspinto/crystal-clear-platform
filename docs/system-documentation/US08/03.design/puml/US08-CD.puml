@startuml US08-CD
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class ValidateDeclarationUI {
}

class ValidateDeclarationController {
    + ValidateDeclarationController()
    + getPendingDeclarations() : List<Declaration>
    + getDeclarationDetails(declaration : Declaration) : String
    + getValidationOutcomes() : List<ValidationOutcome>
    + processValidation(declaration : Declaration,\noutcome : ValidationOutcome,\ncomments : List<Object[]>) : boolean
    - getCurrentEthicsCommitteeMember() : EthicsCommitteeMember
}

class Repositories <<Singleton>> {
    - {static} instance : Repositories
    - Repositories()
    + {static} getInstance() : Repositories
    + getDeclarationRepository() : DeclarationRepository
    + getValidationRecordRepository() : ValidationRecordRepository
    + getEthicsCommitteeMemberRepository() : EthicsCommitteeMemberRepository
    + getAuthenticationRepository() : AuthenticationRepository
}

class DeclarationRepository {
    + getDeclarationsByStatus(status : DeclarationStatus) : List<Declaration>
    + save(declaration : Declaration) : boolean
}

class ValidationRecordRepository {
    + save(record : ValidationRecord) : boolean
}

class EthicsCommitteeMemberRepository {
    + getByEmail(email : String) : EthicsCommitteeMember
}

class AuthenticationRepository {
    + getCurrentUserSession() : UserSession
}

class Declaration {
    - id : String
    - submissionDate : Date
    - status : DeclarationStatus
    + getDetails() : String
    + setStatus(outcome : ValidationOutcome)
}

class EthicsCommitteeMember {
    - name : String
    - email : String
}

class ValidationRecord {
    - validationDate : Date
    + ValidationRecord(member : EthicsCommitteeMember,\ndeclaration : Declaration,\nvalidationDate : Date,\noutcome : ValidationOutcome)
    + addComment(section : String, comment : String)
}

class ValidationComment {
    - section : String
    - comment : String
}

enum DeclarationStatus {
    PENDING
    VALIDATED
    REJECTED
}

enum ValidationOutcome {
    VALIDATED
    RETURNED_FOR_CORRECTION
}

note right of ValidateDeclarationController
    AC3: declaration must be PENDING
    before any mutation is performed
end note

' ── UI → Controller ───────────────────────────────────────────────────────────
ValidateDeclarationUI .> ValidateDeclarationController

' ── Controller → Repositories (singleton) ────────────────────────────────────
ValidateDeclarationController ..> Repositories : uses
ValidateDeclarationController ..> DeclarationRepository : uses
ValidateDeclarationController ..> ValidationRecordRepository : uses
ValidateDeclarationController ..> EthicsCommitteeMemberRepository : uses
ValidateDeclarationController ..> AuthenticationRepository : uses
ValidateDeclarationController ..> Declaration : uses
ValidateDeclarationController ..> ValidationRecord : creates

' ── Repositories singleton owns all repositories ──────────────────────────────
Repositories *-- DeclarationRepository
Repositories *-- ValidationRecordRepository
Repositories *-- EthicsCommitteeMemberRepository
Repositories *-- AuthenticationRepository

' ── Repositories store domain objects ─────────────────────────────────────────
DeclarationRepository --> "*" Declaration : stores
ValidationRecordRepository --> "*" ValidationRecord : stores
EthicsCommitteeMemberRepository --> "*" EthicsCommitteeMember : stores

' ── Declaration ───────────────────────────────────────────────────────────────
Declaration --> "1" DeclarationStatus : status

' ── ValidationRecord aggregate ────────────────────────────────────────────────
ValidationRecord --> "1" EthicsCommitteeMember : member
ValidationRecord --> "1" Declaration : declaration
ValidationRecord --> "1" ValidationOutcome : outcome
ValidationRecord *-- "*" ValidationComment : comments

@enduml
