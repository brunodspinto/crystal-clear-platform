@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Ethics Committee\nMember" as Member
participant ":System" as System

activate Member

    Member -> System : asks to validate a declaration of interests
    activate System

        System --> Member : shows list of declarations with "pending" status
    deactivate System

    Member -> System : selects a declaration to review
    activate System

        System --> Member : displays full declaration content\n(positions, subsidies, assets, business participations)
    deactivate System

    Member -> System : indicates outcome\n(validated or rejected with comments)
    activate System

        alt declaration is correct
            System --> Member : requests confirmation of validation
        else declaration has inconsistencies
            System --> Member : requests section(s) and comment(s)\ndescribing each inconsistency
        end
    deactivate System

    Member -> System : confirms outcome\n(or provides section comments if rejecting)
    activate System

        alt validated
            System --> Member : displays operation success;\ndeclaration status set to "validated"
        else rejected
            System --> Member : displays operation success;\ndeclaration status set to "rejected";\nreturned to Political Agent for correction
        end
    deactivate System

deactivate Member

@enduml
