@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Ethics Committee\nMember" as Member
participant ":System" as System

activate Member

    Member -> System : asks to validate a declaration of interests
    activate System

        System --> Member : shows list of declarations with "pending" status
    deactivate System

    Member -> System : selects a declaration to review
    activate System

        System --> Member : displays full declaration content\n(positions, subsidies, assets, business participations)
    deactivate System

    Member -> System : indicates outcome\n(validated or rejected)
    activate System

        alt declaration is correct
            System --> Member : requests confirmation of validation
        else declaration has inconsistencies
            System --> Member : requests confirmation of rejection
        end
    deactivate System

    Member -> System : confirms outcome
    activate System
        System --> Member : displays operation success;\ndeclaration status set to outcome
    deactivate System

    opt outcome is rejected
        loop for each inconsistent section
            Member -> System : provides section and comment\ndescribing the inconsistency
            activate System
                System --> Member : acknowledges comment;\nasks if there are more sections to comment
            deactivate System
        end
    end

deactivate Member

@enduml
