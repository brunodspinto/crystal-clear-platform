@startuml US11-DM
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

hide circle
hide methods

class Journalist {
    name
    email
    phone
}

class Citizen {
    name
    email
}

class "Political Agent" as PoliticalAgent {
    name
    politicalFunction
    mandateStart
    mandateEnd
}

class "Declaration of Interests" as Declaration {
    id
    name
    position
    submissionDate
}

enum Type {
    Initial
    Regular
    Exceptional
}

class Asset {
    acquisitionValue
    marketValue
}

class "Real Estate" as RealEstate {
    description
}

Journalist "*" -- "*" PoliticalAgent : consults assets of
Citizen "*" -- "*" PoliticalAgent : consults assets of

PoliticalAgent "*" -- "*" Declaration : has

Declaration "1" -- "1" Type : has
Declaration "1" -- "*" Asset : has

Asset "1" -- "1" RealEstate : can be

@enduml
