@startuml US11-CD
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class ConsultAssetsUI {
}

class ConsultAssetsController {
    + ConsultAssetsController()
    + getPoliticalAgents() : List<PoliticalAgent>
    + getAssetsAt(agent, referenceDate) : List<AssetEntry>
    + isCurrentUserJournalist() : boolean
}

class Repositories <<Singleton>> {
    - {static} instance : Repositories
    - Repositories()
    + {static} getInstance() : Repositories
    + getAuthenticationRepository() : AuthenticationRepository
    + getPoliticalAgentRepository() : PoliticalAgentRepository
    + getDeclarationRepository() : DeclarationRepository
}

class AuthenticationRepository {
    + getCurrentUserSession() : UserSession
}

class UserSession {
    + isLoggedIn() : boolean
    + getUserRoles() : List<UserRoleDTO>
}

class PoliticalAgentRepository {
    + getAll() : List<PoliticalAgent>
}

class DeclarationRepository {
    + getValidatedDeclarationsForAgentUpTo(agent, referenceDate) : List<Declaration>
}

class PoliticalAgent {
    - name
    - email
    - nationalIdentityCard
    - taxIdentificationNumber
}

class "Declaration of Interests" as Declaration {
    - id
    - submissionDate
    - status
    + getAssetEntries()
}

enum DeclarationStatus <<enumeration>> {
    PENDING
    VALIDATED
    REJECTED
}

class AssetEntry {
    - assetType
    - assetValue
    + getAssetType()
    + getAssetValue()
    + getRealEstate()
    + getVehicleAsset()
    + getStockAsset()
}

enum AssetType <<enumeration>> {
    REAL_ESTATE
    VEHICLES
    STOCKS
}

class RealEstate {
    - description
    - municipality
}

class VehicleAsset {
}

class StockAsset {
}

ConsultAssetsUI .> ConsultAssetsController
ConsultAssetsUI ..> AssetEntry
ConsultAssetsUI ..> RealEstate
ConsultAssetsUI ..> VehicleAsset
ConsultAssetsUI ..> StockAsset
ConsultAssetsUI ..> AssetType

ConsultAssetsController ..> Repositories
Repositories ..> AuthenticationRepository
Repositories ..> PoliticalAgentRepository
Repositories ..> DeclarationRepository
ConsultAssetsController ..> AuthenticationRepository
ConsultAssetsController ..> PoliticalAgentRepository
ConsultAssetsController ..> DeclarationRepository
ConsultAssetsController ..> PoliticalAgent
ConsultAssetsController ..> Declaration
ConsultAssetsController ..> AssetEntry
ConsultAssetsController ..> UserSession

AuthenticationRepository --> "0..1" UserSession : current >
PoliticalAgentRepository --> "*" PoliticalAgent : agents
DeclarationRepository --> "*" Declaration : declarations

PoliticalAgent "1" -- "*" Declaration : submits >
Declaration "*" -- "1" DeclarationStatus : has >
Declaration "1" *-- "*" AssetEntry : declares >
AssetEntry "*" -- "1" AssetType : has >
AssetEntry "0..1" -- "0..1" RealEstate : details >
AssetEntry "0..1" -- "0..1" VehicleAsset : details >
AssetEntry "0..1" -- "0..1" StockAsset : details >

note bottom of AssetEntry
    {xor} exactly one of RealEstate /
    VehicleAsset / StockAsset is set,
    according to the AssetType.
end note

note right of ConsultAssetsController
    getAssetsAt validates inputs:
    throws IllegalArgumentException if agent or
    referenceDate is null. Then iterates the validated
    declarations and collects each AssetEntry.

    AC4: isCurrentUserJournalist() returns true when the
    current UserSession is logged in and has a role
    whose description equals "JOURNALIST"; the UI uses
    the boolean to decide whether to mask sensitive values.
    The comparison uses the role description string because
    the AuthLib exposes roles as UserRoleDTO (id/description),
    so the description is the only stable identifier available.
end note

note bottom of DeclarationRepository
    AC2: returns only declarations
    with status = VALIDATED and
    submissionDate <= referenceDate
end note

@enduml
