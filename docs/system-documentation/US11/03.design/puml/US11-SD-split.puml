@startuml US11-SD-split
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Citizen / Journalist" as Actor
participant ":ConsultAssetsUI" as UI
participant ":ConsultAssetsController" as CTRL
participant ":Repositories" as REPOS

activate Actor

    Actor -> UI : asks to consult assets of a political agent
    activate UI

        UI --> CTRL** : create()
        activate CTRL
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS

            CTRL -> REPOS : getPoliticalAgentRepository()
            activate REPOS
                REPOS --> CTRL : politicalAgentRepository
            deactivate REPOS

            CTRL -> REPOS : getDeclarationRepository()
            activate REPOS
                REPOS --> CTRL : declarationRepository
            deactivate REPOS

            CTRL -> REPOS : getAuthenticationRepository()
            activate REPOS
                REPOS --> CTRL : authenticationRepository
            deactivate REPOS
        deactivate CTRL

        UI -> CTRL : getPoliticalAgents()
        ref over CTRL
            Get Political Agents
        end ref

        activate CTRL
            CTRL --> UI : agents
        deactivate CTRL

        UI --> Actor : shows agent list, requests selection
    deactivate UI

    Actor -> UI : selects agent (AC1)
    activate UI
        UI --> Actor : requests reference date
    deactivate UI

    Actor -> UI : enters reference date
    activate UI

        UI -> CTRL : getAssetsAt(agent, referenceDate)
        activate CTRL

            alt agent == null
                CTRL --> UI : throw IllegalArgumentException("Agent cannot be null.")
            else referenceDate == null
                CTRL --> UI : throw IllegalArgumentException("Reference date cannot be null.")
            else valid input
                ref over CTRL
                    Get Validated Declarations For Agent Up To
                end ref

                ref over CTRL
                    Collect Assets
                end ref

                CTRL --> UI : assets
            end
        deactivate CTRL

        alt assets is empty (AC3)
            UI --> Actor : shows "no validated declarations up to that date"
        else
            UI -> CTRL : isCurrentUserJournalist()
            ref over CTRL
                Get Current User Role
            end ref

            activate CTRL
                CTRL --> UI : isJournalist
            deactivate CTRL

            UI --> Actor : shows assets\n(masked when not journalist)
        end

    deactivate UI

deactivate Actor

@enduml
