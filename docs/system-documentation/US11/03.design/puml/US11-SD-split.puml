@startuml US11-SD-split
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Citizen / Journalist" as Actor
participant ":ConsultAssetsUI" as UI
participant ":ConsultAssetsController" as CTRL

activate Actor

    Actor -> UI : asks to consult assets of a political agent
    activate UI

        UI --> CTRL** : create()
        UI -> CTRL : getPoliticalAgents()
        ref over CTRL
            Get Political Agents
        end ref

        activate CTRL
            CTRL --> UI : agents
        deactivate CTRL

        UI --> Actor : shows agent list, requests selection
    deactivate UI

    Actor -> UI : selects agent (AC1)
    activate UI
        UI --> Actor : requests reference date
    deactivate UI

    Actor -> UI : enters reference date
    activate UI

        UI -> CTRL : getAssetsAt(agent, referenceDate)
        activate CTRL

            ref over CTRL
                Get Validated Declarations For Agent Up To
            end ref

            ref over CTRL
                Collect Assets
            end ref

            CTRL --> UI : assetEntries
        deactivate CTRL

        alt assets is empty (AC3)
            UI --> Actor : shows "no validated declarations up to that date"
        else
            UI -> CTRL : isCurrentUserJournalist()
            ref over CTRL
                Check Current User Role
            end ref

            activate CTRL
                CTRL --> UI : isJournalist
            deactivate CTRL

            UI --> Actor : shows assets\n(masked when not journalist)
        end

    deactivate UI

deactivate Actor

@enduml
