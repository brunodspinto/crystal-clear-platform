@startuml US11-SD-partial-collect-assets
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

participant ":ConsultAssetsController" as CTRL
participant "d:Declaration" as DEC

autonumber 11
 -> CTRL : getAssetsAt(agent, referenceDate)
autonumber 11.1
activate CTRL
    group Collect Assets

        CTRL -> CTRL : assets := new ArrayList<AssetEntry>()
        activate CTRL
        deactivate CTRL

        loop for each d in declarations
            CTRL -> DEC : getAssetEntries()
            activate DEC
                DEC --> CTRL : assetEntries
            deactivate DEC

            loop for each a in assetEntries
                CTRL -> CTRL : assets.add(a)
                activate CTRL
                deactivate CTRL
            end
        end

    end
    autonumber 12
    <-- CTRL : assets
deactivate CTRL

note over CTRL
    Returns an empty list (AC3) when
    declarations is empty.
    AC4 (masking) is handled by
    the UI using the boolean from
    isCurrentUserJournalist().
end note

@enduml
