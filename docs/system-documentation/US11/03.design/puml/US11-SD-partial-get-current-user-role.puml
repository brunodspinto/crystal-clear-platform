@startuml US11-SD-partial-get-current-user-role
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

participant ":ConsultAssetsUI" as UI
participant ":ConsultAssetsController" as CTRL
participant ":AuthenticationRepository" as AUTH
participant "session:UserSession" as SESS

 -> UI : after fetching assetEntries
activate UI

    UI -> CTRL : isCurrentUserJournalist()
    activate CTRL

        alt authenticationRepository == null
            CTRL --> UI : false
        else
            CTRL -> AUTH : getCurrentUserSession()
            activate AUTH
                AUTH --> CTRL : session
            deactivate AUTH

            alt session == null
                CTRL --> UI : false
            else
                CTRL -> SESS : isLoggedIn()
                activate SESS
                    SESS --> CTRL : loggedIn
                deactivate SESS

                alt !loggedIn
                    CTRL --> UI : false
                else
                    CTRL -> SESS : getUserRoles()
                    activate SESS
                        SESS --> CTRL : roles
                    deactivate SESS

                    alt roles == null
                        CTRL --> UI : false
                    else
                        loop for each role in roles
                            CTRL -> CTRL : role.getDescription().equals("Journalist") ?
                            activate CTRL
                            deactivate CTRL
                        end

                        note right of CTRL
                            AC4: returns true if any role
                            description equals "Journalist";
                            false otherwise (Citizen).
                            The UI uses this flag to mask
                            sensitive values when not journalist.
                        end note

                        CTRL --> UI : isJournalist
                    end
                end
            end
        end
    deactivate CTRL

deactivate UI

@enduml
