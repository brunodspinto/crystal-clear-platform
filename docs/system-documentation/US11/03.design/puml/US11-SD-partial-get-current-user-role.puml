@startuml US11-SD-partial-get-current-user-role
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

participant ":ConsultAssetsUI" as UI
participant ":ConsultAssetsController" as CTRL
participant ":AuthenticationRepository" as AUTH
participant "session:UserSession" as SESS

 -> UI : after fetching assetEntries
activate UI

    UI -> CTRL : isCurrentUserJournalist()
    activate CTRL

        note right of CTRL
            AC4: returns true when the
            current session has the
            Journalist role.
            The UI uses this to mask or
            show sensitive values.
        end note

        CTRL -> AUTH : getCurrentUserSession()
        activate AUTH
            AUTH --> CTRL : session
        deactivate AUTH

        CTRL -> SESS : isLoggedIn()
        activate SESS
            SESS --> CTRL : true
        deactivate SESS

        CTRL -> SESS : getUserRoles()
        activate SESS
            SESS --> CTRL : roles
        deactivate SESS

        CTRL --> UI : isJournalist
    deactivate CTRL

deactivate UI

@enduml
