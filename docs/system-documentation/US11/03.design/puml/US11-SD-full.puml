@startuml US11-SD-full
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Citizen / Journalist" as Actor
participant ":ConsultAssetsUI" as UI
participant ":ConsultAssetsController" as CTRL
participant ":AuthenticationRepository" as AUTH
participant ":PoliticalAgentRepository" as PAR
participant ":DeclarationRepository" as DR
participant "d:Declaration" as DEC

activate Actor

    Actor -> UI : asks to consult assets of a political agent
    activate UI

        UI -> CTRL : getPoliticalAgents()
        activate CTRL

            CTRL -> PAR : getAll()
            activate PAR
                PAR --> CTRL : agents
            deactivate PAR

            CTRL --> UI : agents
        deactivate CTRL

        UI --> Actor : shows agent list, requests selection
    deactivate UI

    Actor -> UI : selects agent (AC1)
    activate UI

        UI --> Actor : requests reference date
    deactivate UI

    Actor -> UI : enters reference date
    activate UI

        UI -> CTRL : getAssetsAt(agent, referenceDate)
        activate CTRL

            CTRL -> DR : getValidatedDeclarationsForAgentUpTo(agent, referenceDate)
            activate DR

                note right of DR
                    AC2: only declarations with
                    status = VALIDATED and
                    submissionDate <= referenceDate
                end note

                DR --> CTRL : declarations
            deactivate DR

            alt declarations is empty (AC3)
                CTRL --> UI : empty list
            else
                loop for each d in declarations
                    CTRL -> DEC : getAssetEntries()
                    activate DEC
                        DEC --> CTRL : assetEntries
                    deactivate DEC
                end

                CTRL --> UI : assetEntries
            end

        deactivate CTRL

        alt assets is empty (AC3)
            UI --> Actor : shows "no validated declarations up to that date"
        else
            UI -> CTRL : isCurrentUserJournalist()
            activate CTRL

                CTRL -> AUTH : getCurrentUserSession()
                activate AUTH
                    AUTH --> CTRL : session
                deactivate AUTH

                note right of CTRL
                    AC4: true if session role
                    contains "Journalist";
                    false otherwise (Citizen).
                end note

                CTRL --> UI : isJournalist
            deactivate CTRL

            UI --> Actor : shows assets\n(masked when not journalist)
        end

    deactivate UI

deactivate Actor

@enduml
