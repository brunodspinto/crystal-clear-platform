@startuml US11-SD-full
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Citizen / Journalist" as Actor
participant ":ConsultAssetsUI" as UI
participant ":ConsultAssetsController" as CTRL
participant ":Repositories" as REPOS
participant ":PoliticalAgentRepository" as PAR
participant ":DeclarationRepository" as DR
participant ":AuthenticationRepository" as AUTH
participant "d:Declaration" as DEC
participant "session:UserSession" as SESS

activate Actor

    Actor -> UI : asks to consult assets of a political agent
    activate UI

        UI --> CTRL** : create()
        activate CTRL
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS

            CTRL -> REPOS : getPoliticalAgentRepository()
            activate REPOS
                REPOS --> CTRL : politicalAgentRepository
            deactivate REPOS

            CTRL -> REPOS : getDeclarationRepository()
            activate REPOS
                REPOS --> CTRL : declarationRepository
            deactivate REPOS

            CTRL -> REPOS : getAuthenticationRepository()
            activate REPOS
                REPOS --> CTRL : authenticationRepository
            deactivate REPOS
        deactivate CTRL

        UI -> CTRL : getPoliticalAgents()
        activate CTRL

            CTRL -> PAR : getAll()
            activate PAR
                PAR --> CTRL : agents
            deactivate PAR

            CTRL --> UI : agents
        deactivate CTRL

        UI --> Actor : shows agent list, requests selection
    deactivate UI

    Actor -> UI : selects agent (AC1)
    activate UI

        UI --> Actor : requests reference date
    deactivate UI

    Actor -> UI : enters reference date
    activate UI

        UI -> CTRL : getAssetsAt(agent, referenceDate)
        activate CTRL

            alt agent == null
                CTRL --> UI : throw IllegalArgumentException("Agent cannot be null.")
            else referenceDate == null
                CTRL --> UI : throw IllegalArgumentException("Reference date cannot be null.")
            else valid input
                CTRL -> DR : getValidatedDeclarationsForAgentUpTo(agent, referenceDate)
                activate DR

                    note right of DR
                        AC2: only declarations with
                        status = VALIDATED and
                        submissionDate <= referenceDate
                    end note

                    DR --> CTRL : declarations
                deactivate DR

                CTRL -> CTRL : assets := new ArrayList<AssetEntry>()
                activate CTRL
                deactivate CTRL

                loop for each d in declarations
                    CTRL -> DEC : getAssetEntries()
                    activate DEC
                        DEC --> CTRL : assetEntries
                    deactivate DEC

                    loop for each a in assetEntries
                        CTRL -> CTRL : assets.add(a)
                        activate CTRL
                        deactivate CTRL
                    end
                end

                CTRL --> UI : assets
            end
        deactivate CTRL

        alt assets is empty (AC3)
            UI --> Actor : shows "no validated declarations up to that date"
        else
            UI -> CTRL : isCurrentUserJournalist()
            activate CTRL

                alt authenticationRepository == null
                    CTRL --> UI : false
                else
                    CTRL -> AUTH : getCurrentUserSession()
                    activate AUTH
                        AUTH --> CTRL : session
                    deactivate AUTH

                    alt session == null
                        CTRL --> UI : false
                    else
                        CTRL -> SESS : isLoggedIn()
                        activate SESS
                            SESS --> CTRL : loggedIn
                        deactivate SESS

                        alt !loggedIn
                            CTRL --> UI : false
                        else
                            CTRL -> SESS : getUserRoles()
                            activate SESS
                                SESS --> CTRL : roles
                            deactivate SESS

                            alt roles == null
                                CTRL --> UI : false
                            else
                                loop for each role in roles
                                    CTRL -> CTRL : role.getDescription().equals("JOURNALIST") ?
                                    activate CTRL
                                    deactivate CTRL
                                end

                                note right of CTRL
                                    AC4: returns true if any role
                                    description equals "JOURNALIST";
                                    false otherwise (Citizen).
                                end note

                                CTRL --> UI : isJournalist
                            end
                        end
                    end
                end
            deactivate CTRL

            UI --> Actor : shows assets\n(masked when not journalist)
        end

    deactivate UI

deactivate Actor

@enduml
