<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.SubnetworkFXController">
   <children>
      <Label styleClass="scene-title" text="Influence Subnetwork Visualisation" />
      <Label text="Extracts the connected subnetwork that contains a chosen entity. All entities in this subnetwork can participate in influence chains that pass through the chosen entity. Pick a snapshot date to extract the subnetwork as it stood on that date." wrapText="true" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label minWidth="120.0" styleClass="field-label" text="Snapshot date:" />
            <DatePicker fx:id="datePicker" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label minWidth="120.0" styleClass="field-label" text="Origin entity:" />
            <ComboBox fx:id="originCombo" prefWidth="280.0" styleClass="combo-box" />
         </children>
      </HBox>
      <Label fx:id="messageLabel" maxWidth="1.7976931348623157E308" wrapText="true" />
      <Label fx:id="resultLabel" maxWidth="1.7976931348623157E308" styleClass="field-label" wrapText="true" />
      <ListView fx:id="nodesList" prefHeight="240.0" VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleExtract" styleClass="primary-button" text="Extract Subnetwork" />
            <Button fx:id="exportButton" mnemonicParsing="false" onAction="#handleExportSvg" styleClass="primary-button" text="Export to SVG" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
   </padding>
</VBox>
