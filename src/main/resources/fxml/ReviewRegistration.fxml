<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ipp.isep.dei.ui.gui.ReviewRegistrationFXController"
      styleClass="root-pane"
      stylesheets="@../css/app.css"
      spacing="10">
    <padding><Insets top="20" right="28" bottom="20" left="28"/></padding>

    <Label text="Review Registration Requests" styleClass="scene-title"/>

    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- Left: list of pending requests -->
        <VBox spacing="6" prefWidth="260" minWidth="200">
            <Label text="Pending requests:" styleClass="field-label"/>
            <ListView fx:id="requestList" VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- Right: details + decision -->
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Request details:" styleClass="field-label"/>

            <GridPane hgap="12" vgap="6">
                <columnConstraints>
                    <ColumnConstraints minWidth="80"/>
                    <ColumnConstraints minWidth="220" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="detailName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="detailEmail" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Role:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="detailRole" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Submitted:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="detailDate" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Document:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="detailDoc" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <Label text="Rejection reason (mandatory for reject):" styleClass="field-label"/>
            <TextArea fx:id="reasonArea" prefRowCount="3" wrapText="true"/>

            <Label fx:id="messageLabel" maxWidth="Infinity"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="acceptButton" text="Accept" onAction="#handleAccept"
                        defaultButton="true" styleClass="primary-button" disable="true"/>
                <Button fx:id="rejectButton" text="Reject" onAction="#handleReject"
                        styleClass="secondary-button" disable="true"/>
                <Button text="Back" onAction="#handleBack" styleClass="secondary-button"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
