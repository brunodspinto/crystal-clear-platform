<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.DetectNepotismFXController">
   <children>
      <Label styleClass="scene-title" text="Direct Nepotism Detection" />
      <Label text="Flags every case where someone was appointed by a person they have a personal tie with (relativeOf, friendOf or associatedWith)." wrapText="true" />
      <Label fx:id="messageLabel" maxWidth="1.7976931348623157E308" wrapText="true" />
      <Label fx:id="resultLabel" maxWidth="1.7976931348623157E308" styleClass="field-label" wrapText="true" />
      <TableView fx:id="pairsTable" prefHeight="280.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colAppointed" prefWidth="220.0" text="Appointed" />
            <TableColumn fx:id="colAppointer" prefWidth="220.0" text="Appointed by" />
            <TableColumn fx:id="colTie" prefWidth="200.0" text="Personal tie" />
         </columns>
      </TableView>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleDetect" styleClass="primary-button" text="Detect" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
   </padding>
</VBox>
