<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.AssessComplaintFXController">
   <children>
      <Label styleClass="scene-title" text="Assess Complaint" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Label styleClass="field-label" text="Complaint:" />
            <ComboBox fx:id="complaintCombo" onAction="#handleComplaintSelected" prefWidth="320.0" />
         </children>
      </HBox>
      <GridPane hgap="12.0" vgap="6.0">
         <children>
            <Label styleClass="field-label" text="Political Agent:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="detailAgent" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label styleClass="field-label" text="Citizen:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="detailCitizen" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label styleClass="field-label" text="Submitted:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="detailSubmitted" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
         <columnConstraints>
            <ColumnConstraints minWidth="130.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="260.0" />
         </columnConstraints>
      </GridPane>
      <Label styleClass="field-label" text="Grievances:" />
      <ListView fx:id="grievancesList" prefHeight="120.0" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Label styleClass="field-label" text="Outcome:" />
            <ComboBox fx:id="outcomeCombo" prefWidth="160.0" />
         </children>
      </HBox>
      <Label styleClass="field-label" text="Reason (mandatory if invalid):" />
      <TextArea fx:id="reasonArea" prefRowCount="3" wrapText="true" />
      <Label fx:id="messageLabel" maxWidth="Infinity" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleAssess" styleClass="primary-button" text="Assess" />
            <Button mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="28.0" right="28.0" top="20.0" />
   </padding>
</VBox>
