<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.FindPathFXController">
   <children>
      <Label styleClass="scene-title" text="US34 — Pathway Verification" />
      <Label text="Checks whether two entities are connected in the support graph and returns the shortest distance (number of edges)." wrapText="true" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label minWidth="120.0" styleClass="field-label" text="Source entity:" />
            <ComboBox fx:id="sourceCombo" prefWidth="280.0" styleClass="combo-box" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label minWidth="120.0" styleClass="field-label" text="Target entity:" />
            <ComboBox fx:id="targetCombo" prefWidth="280.0" styleClass="combo-box" />
         </children>
      </HBox>
      <Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true" />
      <Label fx:id="resultLabel" maxWidth="Infinity" styleClass="field-label" wrapText="true" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleFindPath" styleClass="primary-button" text="Find Path" />
            <Button mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
   </padding>
</VBox>
