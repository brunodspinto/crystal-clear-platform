<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.IntegratedSituationFXController">
   <children>
      <Label styleClass="scene-title" text="Consult Integrated Situation" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Label styleClass="field-label" text="Agent:" />
            <ComboBox fx:id="agentCombo" prefWidth="220.0" />
            <Label styleClass="field-label" text="Reference date:" />
            <DatePicker fx:id="datePicker" />
            <Button mnemonicParsing="false" onAction="#handleSearch" styleClass="primary-button" text="Search" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
      <Label fx:id="messageLabel" maxWidth="1.7976931348623157E308" />
      <TableView fx:id="declarationsTable" prefHeight="180.0">
         <columns>
            <TableColumn fx:id="colType" prefWidth="200.0" text="Type" />
            <TableColumn fx:id="colDate" prefWidth="140.0" text="Submission date" />
            <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
         </columns>
         <placeholder>
            <Label text="No declarations to display." />
         </placeholder>
      </TableView>
      <Label styleClass="field-label" text="Details of the selected declaration:" />
      <TextArea fx:id="detailsArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
   </children>
   <padding>
      <Insets bottom="20.0" left="28.0" right="28.0" top="20.0" />
   </padding>
</VBox>
