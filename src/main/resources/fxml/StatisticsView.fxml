<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.StatisticsAnalysisFXController">
   <children>
      <Label fx:id="titleLabel" styleClass="scene-title" text="Statistics" />
      <Label fx:id="descriptionLabel" wrapText="true" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button fx:id="runButton" defaultButton="true" mnemonicParsing="false" onAction="#handleRun" styleClass="primary-button" text="Run analysis" />
            <Button fx:id="openButton" mnemonicParsing="false" onAction="#handleOpenGraphs" styleClass="secondary-button" text="Open graph(s)" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
      <Label fx:id="statusLabel" maxWidth="Infinity" />
      <Label styleClass="field-label" text="Output:" />
      <TextArea fx:id="logArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
   </children>
   <padding>
      <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
   </padding>
</VBox>
