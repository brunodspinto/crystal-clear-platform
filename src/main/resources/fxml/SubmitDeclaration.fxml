<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="0.0" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.SubmitDeclarationFXController">
   <children>
      <VBox spacing="8.0" styleClass="root-pane">
         <children>
            <Label styleClass="scene-title" text="Submit Declaration of Interests" />
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label minWidth="130.0" styleClass="field-label" text="Declaration Type:" />
                  <ComboBox fx:id="typeCombo" prefWidth="180.0" styleClass="input-field" />
               </children>
            </HBox>
            <VBox fx:id="exceptionalBox" spacing="6.0" style="-fx-border-color: #e8c2bf; -fx-border-radius: 4; -fx-background-color: #fdf0ef; -fx-background-radius: 4; -fx-padding: 10;">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #c0392b;" text="Exceptional Declaration — additional information required" />
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label minWidth="160.0" text="Amended Declaration ID:" />
                        <TextField fx:id="amendedIdField" prefWidth="160.0" promptText="e.g. DECL-3" styleClass="input-field" />
                        <Label text="Amendment Reason:" />
                        <TextField fx:id="amendReasonField" prefWidth="300.0" promptText="Reason for correction or amendment" styleClass="input-field" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Label minWidth="130.0" style="-fx-font-size: 11px; -fx-text-fill: #555;" text="Import from previous:" />
                  <ComboBox fx:id="importCombo" prefWidth="340.0" styleClass="input-field" />
                  <Button fx:id="importButton" mnemonicParsing="false" onAction="#handleImport" styleClass="secondary-button" text="Import data" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="14.0" />
         </padding>
      </VBox>
      <Separator />
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
         <content>
            <Accordion>
               <panes>
                  <TitledPane text="0. Household (Spouse, Descendants and Others)">
                     <content>
                        <VBox spacing="8.0">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-text-fill: #666;" text="Declare your partner, descendants and any other family members you wish to include." />
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="80.0" text="Full Name:" />
                                    <TextField fx:id="hhNameField" prefWidth="240.0" promptText="Full name" styleClass="input-field" />
                                    <Label text="Relation:" />
                                    <ComboBox fx:id="hhRelationCombo" prefWidth="140.0" styleClass="input-field" />
                                    <Button mnemonicParsing="false" onAction="#handleAddHousehold" prefWidth="70.0" styleClass="primary-button" text="Add" />
                                    <Button mnemonicParsing="false" onAction="#handleRemoveHousehold" styleClass="secondary-button" text="Remove" />
                                 </children>
                              </HBox>
                              <TableView fx:id="hhTable" prefHeight="120.0">
                                 <columns>
                                    <TableColumn fx:id="hhColName" prefWidth="280.0" text="Full Name" />
                                    <TableColumn fx:id="hhColRelation" prefWidth="160.0" text="Relation" />
                                 </columns>
                                 <placeholder>
                                    <Label text="No household members declared." />
                                 </placeholder>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </TitledPane>
                  <TitledPane expanded="true" text="1. Position / Job Entries (required)">
                     <content>
                        <VBox spacing="8.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="90.0" text="Organisation:" />
                                    <ComboBox fx:id="posOrgCombo" prefWidth="200.0" styleClass="input-field" />
                                    <Label text="Function:" />
                                    <TextField fx:id="posFunctionField" prefWidth="160.0" promptText="e.g. Minister" styleClass="input-field" />
                                    <Label text="Nature:" />
                                    <ComboBox fx:id="posNatureCombo" prefWidth="110.0" styleClass="input-field" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="90.0" text="Gross Salary:" />
                                    <TextField fx:id="posGrossField" prefWidth="110.0" promptText="Annual €" styleClass="input-field" />
                                    <Label text="Consulting:" />
                                    <TextField fx:id="posConsultingField" prefWidth="110.0" promptText="Side income €" styleClass="input-field" />
                                    <Label text="Board:" />
                                    <TextField fx:id="posBoardField" prefWidth="110.0" promptText="Board fees €" styleClass="input-field" />
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="90.0" text="Start Date:" />
                                    <DatePicker fx:id="posStartField" prefWidth="150.0" />
                                    <Label text="End Date:" />
                                    <DatePicker fx:id="posEndField" prefWidth="150.0" />
                                    <Button mnemonicParsing="false" onAction="#handleAddPosition" prefWidth="70.0" styleClass="primary-button" text="Add" />
                                    <Button mnemonicParsing="false" onAction="#handleRemovePosition" styleClass="secondary-button" text="Remove selected" />
                                 </children>
                              </HBox>
                              <TableView fx:id="posTable" prefHeight="130.0">
                                 <columns>
                                    <TableColumn fx:id="posColOrg" prefWidth="170.0" text="Organisation" />
                                    <TableColumn fx:id="posColFunc" prefWidth="150.0" text="Function" />
                                    <TableColumn fx:id="posColNature" prefWidth="80.0" text="Nature" />
                                    <TableColumn fx:id="posColGross" prefWidth="100.0" text="Gross (€)" />
                                    <TableColumn fx:id="posColStart" prefWidth="100.0" text="Start" />
                                 </columns>
                                 <placeholder>
                                    <Label text="No position entries added yet." />
                                 </placeholder>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </TitledPane>
                  <TitledPane text="2. Support and Subsidies">
                     <content>
                        <VBox spacing="8.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="90.0" text="Organisation:" />
                                    <ComboBox fx:id="subOrgCombo" prefWidth="200.0" styleClass="input-field" />
                                    <Label text="Amount (€):" />
                                    <TextField fx:id="subAmountField" prefWidth="110.0" promptText="0.00" styleClass="input-field" />
                                    <Label text="Description:" />
                                    <TextField fx:id="subDescField" prefWidth="180.0" promptText="e.g. Research grant" styleClass="input-field" />
                                    <Label text="Date:" />
                                    <DatePicker fx:id="subDateField" prefWidth="150.0" />
                                    <Button mnemonicParsing="false" onAction="#handleAddSubsidy" prefWidth="70.0" styleClass="primary-button" text="Add" />
                                    <Button mnemonicParsing="false" onAction="#handleRemoveSubsidy" styleClass="secondary-button" text="Remove" />
                                 </children>
                              </HBox>
                              <TableView fx:id="subTable" prefHeight="120.0">
                                 <columns>
                                    <TableColumn fx:id="subColOrg" prefWidth="200.0" text="Organisation" />
                                    <TableColumn fx:id="subColAmount" prefWidth="120.0" text="Amount (€)" />
                                    <TableColumn fx:id="subColDesc" prefWidth="280.0" text="Description" />
                                 </columns>
                                 <placeholder>
                                    <Label text="No subsidy entries added yet." />
                                 </placeholder>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </TitledPane>
                  <TitledPane text="3. Assets (Real Estate, Vehicles, Stocks)">
                     <content>
                        <VBox spacing="8.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="80.0" text="Asset Type:" />
                                    <ComboBox fx:id="assetTypeCombo" prefWidth="140.0" styleClass="input-field" />
                                    <Label text="Value (€):" />
                                    <TextField fx:id="assetValueField" prefWidth="130.0" promptText="Estimated value" styleClass="input-field" />
                                    <Label text="Detail:" />
                                    <TextField fx:id="assetDetailField" prefWidth="180.0" promptText="Description / model / ticker" styleClass="input-field" />
                                    <Label text="Municipality:" />
                                    <TextField fx:id="assetMunicipalityField" prefWidth="130.0" promptText="real estate only" styleClass="input-field" />
                                    <Button mnemonicParsing="false" onAction="#handleAddAsset" prefWidth="70.0" styleClass="primary-button" text="Add" />
                                    <Button mnemonicParsing="false" onAction="#handleRemoveAsset" styleClass="secondary-button" text="Remove" />
                                 </children>
                              </HBox>
                              <Label style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Detail: Real Estate = description (+ municipality), Vehicles = model, Stocks = share name." />
                              <TableView fx:id="assetTable" prefHeight="120.0">
                                 <columns>
                                    <TableColumn fx:id="assetColType" prefWidth="130.0" text="Type" />
                                    <TableColumn fx:id="assetColValue" prefWidth="120.0" text="Value (€)" />
                                    <TableColumn fx:id="assetColDetail" prefWidth="300.0" text="Detail" />
                                 </columns>
                                 <placeholder>
                                    <Label text="No asset entries added yet." />
                                 </placeholder>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </TitledPane>
                  <TitledPane text="4. Business Participations (Quotas / Shares)">
                     <content>
                        <VBox spacing="8.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label minWidth="90.0" text="Organisation:" />
                                    <ComboBox fx:id="bizOrgCombo" prefWidth="200.0" styleClass="input-field" />
                                    <Label text="Company NIF:" />
                                    <TextField fx:id="bizNifField" prefWidth="120.0" promptText="9-digit NIF" styleClass="input-field" />
                                    <Label text="Total Value (€):" />
                                    <TextField fx:id="bizValueField" prefWidth="110.0" promptText="0.00" styleClass="input-field" />
                                    <Label text="Percentage (%):" />
                                    <TextField fx:id="bizPctField" prefWidth="90.0" promptText="0–100" styleClass="input-field" />
                                    <Button mnemonicParsing="false" onAction="#handleAddBusiness" prefWidth="70.0" styleClass="primary-button" text="Add" />
                                    <Button mnemonicParsing="false" onAction="#handleRemoveBusiness" styleClass="secondary-button" text="Remove" />
                                 </children>
                              </HBox>
                              <TableView fx:id="bizTable" prefHeight="120.0">
                                 <columns>
                                    <TableColumn fx:id="bizColOrg" prefWidth="180.0" text="Organisation" />
                                    <TableColumn fx:id="bizColNif" prefWidth="110.0" text="NIF" />
                                    <TableColumn fx:id="bizColValue" prefWidth="130.0" text="Total Value (€)" />
                                    <TableColumn fx:id="bizColPct" prefWidth="100.0" text="Percentage" />
                                 </columns>
                                 <placeholder>
                                    <Label text="No business participations added yet." />
                                 </placeholder>
                              </TableView>
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </TitledPane>
               </panes>
            </Accordion>
         </content>
      </ScrollPane>
      <VBox spacing="8.0">
         <children>
            <Label fx:id="messageLabel" maxWidth="1.7976931348623157E308" wrapText="true" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button cancelButton="true" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
                  <Button fx:id="submitButton" mnemonicParsing="false" onAction="#handleSubmit" prefWidth="200.0" styleClass="primary-button" text="Submit Declaration" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="16.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</VBox>
