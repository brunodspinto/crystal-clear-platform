<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="720.0" spacing="12.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.PoliticalAgentMenuController">
   <children>
      <Label styleClass="scene-title" text="Political Agent Menu" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleListOrganizations" styleClass="primary-button" text="List Institutions" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleSubmitDeclaration" styleClass="primary-button" text="Submit Declaration of Interests" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleLogout" styleClass="secondary-button" text="Logout" />
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>
