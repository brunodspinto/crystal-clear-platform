<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.ExportDeclarationCsvFXController">
   <children>
      <Label styleClass="scene-title" text="Export Declarations Dataset (CSV)" />
      <Label text="Exports all validated declarations to a CSV file." />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label minWidth="120.0" styleClass="field-label" text="Destination:" />
            <TextField fx:id="pathField" editable="false" promptText="Choose a file..." styleClass="input-field" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleBrowse" styleClass="secondary-button" text="Browse..." />
         </children>
      </HBox>
      <Label fx:id="messageLabel" maxWidth="Infinity" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleExport" styleClass="primary-button" text="Export" />
            <Button mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
   </padding>
</VBox>
