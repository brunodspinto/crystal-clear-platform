<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" prefHeight="480.0" prefWidth="720.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.EthicsCommitteeMenuController">
   <content>
      <VBox alignment="CENTER" spacing="8.0" styleClass="root-pane">
         <children>
            <Label styleClass="scene-title" text="Ethics Committee Menu" />
            <Label styleClass="field-label" text="Network &amp; validation" />
            <Button maxWidth="300.0" mnemonicParsing="false" onAction="#handleValidateDeclaration" styleClass="primary-button" text="Validate Declaration" />
            <Button maxWidth="300.0" mnemonicParsing="false" onAction="#handleIntegratedSituation" styleClass="primary-button" text="Integrated Situation" />
            <Button maxWidth="300.0" mnemonicParsing="false" onAction="#handleAssessComplaint" styleClass="primary-button" text="Assess Complaint" />
            <Button maxWidth="300.0" mnemonicParsing="false" onAction="#handleDetectNepotism" styleClass="primary-button" text="Detect Nepotism" />
            <Button maxWidth="300.0" mnemonicParsing="false" onAction="#handleDetectConflicts" styleClass="primary-button" text="Detect Conflicts of Interest" />
            <Button maxWidth="300.0" mnemonicParsing="false" onAction="#handleFindPath" styleClass="primary-button" text="Find Pathway" />
            <Button maxWidth="300.0" mnemonicParsing="false" onAction="#handleSubnetwork" styleClass="primary-button" text="Influence Subnetwork" />
            <Button maxWidth="300.0" mnemonicParsing="false" onAction="#handleLogout" styleClass="secondary-button" text="Logout" />
         </children>
         <padding>
            <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
         </padding>
      </VBox>
   </content>
</ScrollPane>
