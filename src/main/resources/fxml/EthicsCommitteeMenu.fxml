<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ipp.isep.dei.ui.gui.EthicsCommitteeMenuController"
      styleClass="root-pane"
      stylesheets="@../css/app.css"
      spacing="9" alignment="CENTER">
    <padding>
        <Insets top="24" right="40" bottom="24" left="40"/>
    </padding>

    <Label text="Ethics Committee Menu" styleClass="scene-title"/>

    <Button text="Validate Declaration" onAction="#handleValidateDeclaration" styleClass="primary-button" maxWidth="260"/>
    <Button text="Integrated Situation" onAction="#handleIntegratedSituation" styleClass="primary-button" maxWidth="260"/>
    <Button text="Assess Complaint" onAction="#handleAssessComplaint" styleClass="primary-button" maxWidth="260"/>
    <Button text="Detect Nepotism" onAction="#handleDetectNepotism" styleClass="primary-button" maxWidth="260"/>
    <Button text="Detect Conflicts of Interest" onAction="#handleDetectConflicts" styleClass="primary-button" maxWidth="260"/>
    <Button text="Find Pathway" onAction="#handleFindPath" styleClass="primary-button" maxWidth="260"/>
    <Button text="Influence Subnetwork" onAction="#handleSubnetwork" styleClass="primary-button" maxWidth="260"/>
    <Button text="Logout" onAction="#handleLogout" styleClass="secondary-button" maxWidth="260"/>
</VBox>
