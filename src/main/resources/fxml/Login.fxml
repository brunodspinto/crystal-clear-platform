<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.LoginController">
   <children>
      <Label style="-fx-font-size: 20px;" text="Sign in" />
      <Label text="Email" />
      <TextField fx:id="emailField" maxWidth="280.0" promptText="email@example.com" />
      <Label text="Password" />
      <PasswordField fx:id="passwordField" maxWidth="280.0" promptText="7 chars, 3 upper, 2 digits" />
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleLogin" text="Login" />
            <Button mnemonicParsing="false" onAction="#handleClear" text="Clear" />
         </children>
      </HBox>
      <Label fx:id="messageLabel" maxWidth="320.0" style="-fx-text-fill: #b00020;" wrapText="true" />
      <HBox alignment="CENTER" spacing="4.0">
         <children>
            <Label text="Don't have an account?" />
            <Hyperlink mnemonicParsing="false" onAction="#handleRegister" styleClass="link-button" text="Register here" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>
