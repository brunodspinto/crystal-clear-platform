<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ipp.isep.dei.ui.gui.AdminMenuController"
      styleClass="root-pane"
      stylesheets="@../css/app.css"
      spacing="10" alignment="CENTER">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Administrator Menu" styleClass="scene-title"/>

    <Button text="Review Registration Requests" onAction="#handleReviewRegistration" styleClass="primary-button" maxWidth="260"/>
    <Button text="Register Organization" onAction="#handleRegisterOrganization" styleClass="primary-button" maxWidth="260"/>
    <Button text="Load Entities from CSV" onAction="#handleLoadEntities" styleClass="primary-button" maxWidth="260"/>
    <Button text="Export Declaration (CSV)" onAction="#handleExportDeclarationCsv" styleClass="primary-button" maxWidth="260"/>
    <Button text="Export Holdings (CSV)" onAction="#handleExportHoldings" styleClass="primary-button" maxWidth="260"/>
    <Button text="Export Graph (SVG)" onAction="#handleExportGraph" styleClass="primary-button" maxWidth="260"/>
    <Button text="Network Dynamics Over Time" onAction="#handleNetworkDynamics" styleClass="primary-button" maxWidth="260"/>
    <Button text="Logout" onAction="#handleLogout" styleClass="secondary-button" maxWidth="260"/>
</VBox>
