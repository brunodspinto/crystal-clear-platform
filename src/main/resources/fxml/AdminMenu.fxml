<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.AdminMenuController">
   <children>
      <Label styleClass="scene-title" text="Administrator Menu" />
      <Button fx:id="reviewButton" maxWidth="260.0" mnemonicParsing="false" onAction="#handleReviewRegistration" styleClass="primary-button" text="Review Registration Requests" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleRegisterOrganization" styleClass="primary-button" text="Register Organization" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleLoadEntities" styleClass="primary-button" text="Load Entities from CSV" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleBuildRelationsGraph" styleClass="primary-button" text="Build Relations Graph" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleAdjacencyMatrices" styleClass="primary-button" text="Adjacency Matrices" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleGlobalSupportMatrix" styleClass="primary-button" text="Global Support Matrix" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleExportDeclarationGraph" styleClass="primary-button" text="Export Declaration Graph (CSV)" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleExportDeclarationCsv" styleClass="primary-button" text="Export Declaration (CSV)" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleExportHoldings" styleClass="primary-button" text="Export Holdings (CSV)" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleExportGraph" styleClass="primary-button" text="Export Graph (SVG)" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleNetworkDynamics" styleClass="primary-button" text="Network Dynamics Over Time" />
      <Button maxWidth="260.0" mnemonicParsing="false" onAction="#handleLogout" styleClass="secondary-button" text="Logout" />
   </children>
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
</VBox>
