<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Register.fxml — US01: Request registration on the platform.
  Controller: pt.ipp.isep.dei.ui.gui.RegisterSceneController
  Loaded by: MainController.showRegister()
-->
<VBox xmlns="http://javafx.com/javafx/11"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ipp.isep.dei.ui.gui.RegisterSceneController"
      styleClass="root-pane"
      stylesheets="@../css/app.css"
      spacing="0"
      maxWidth="460"
      alignment="CENTER">

    <padding>
        <Insets top="32" right="40" bottom="32" left="40"/>
    </padding>

    <!-- Title -->
    <Label text="Crystal Clear" styleClass="app-title"/>
    <Label text="Create Account" styleClass="scene-title"/>
    <Separator styleClass="title-separator"/>

    <!-- Full name -->
    <Label text="Full Name" styleClass="field-label"/>
    <TextField fx:id="fullNameField"
               promptText="Enter your full name"
               styleClass="input-field"/>

    <!-- Email -->
    <Label text="Email Address" styleClass="field-label"/>
    <TextField fx:id="emailField"
               promptText="name@example.com"
               styleClass="input-field"/>

    <!-- Password -->
    <Label text="Password" styleClass="field-label"/>
    <PasswordField fx:id="passwordField"
                   promptText="7 chars · ≥3 uppercase · ≥2 digits"
                   styleClass="input-field"/>
    <Label fx:id="passwordHintLabel"
           text="7 chars · ≥3 uppercase · ≥2 digits · alphanumeric only"
           styleClass="hint-neutral"/>

    <!-- Confirm password -->
    <Label text="Confirm Password" styleClass="field-label"/>
    <PasswordField fx:id="confirmPasswordField"
                   promptText="Repeat your password"
                   styleClass="input-field"/>

    <!-- Role -->
    <Label text="Role" styleClass="field-label"/>
    <ComboBox fx:id="roleComboBox"
              maxWidth="Infinity"
              styleClass="input-field"/>

    <!-- Document row — shown only when role requires it -->
    <HBox fx:id="documentRow" spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="documentLabel" styleClass="field-label" wrapText="true"/>
        <TextField fx:id="documentField"
                   promptText="Document number"
                   styleClass="input-field"
                   HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Feedback -->
    <Label fx:id="messageLabel" styleClass="message-error" wrapText="true"
           maxWidth="Infinity"/>

    <Region VBox.vgrow="NEVER" prefHeight="8"/>

    <!-- Submit -->
    <Button fx:id="submitButton"
            text="Request Registration"
            onAction="#handleSubmit"
            styleClass="primary-button"
            maxWidth="Infinity"/>

    <!-- Back to login -->
    <HBox alignment="CENTER" spacing="4">
        <Label text="Already have an account?"/>
        <Hyperlink text="Back to Login" onAction="#handleBackToLogin"
                   styleClass="link-button"/>
    </HBox>

</VBox>
