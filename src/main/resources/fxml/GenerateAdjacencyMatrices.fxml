<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.GenerateAdjacencyMatricesFXController">
   <children>
      <Label styleClass="scene-title" text="Adjacency Matrices" />
      <Label text="Shows the adjacency matrix of each relation of the graph built in US20, plus the global matrix." />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleGenerate" styleClass="primary-button" text="Generate" />
            <Label styleClass="field-label" text="Matrix:" />
            <ComboBox fx:id="matrixCombo" onAction="#handleMatrixSelected" prefWidth="280.0" styleClass="combo-box" />
         </children>
      </HBox>
      <Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true" />
      <TextArea fx:id="matrixArea" editable="false" style="-fx-font-family: 'Courier New', monospace;" wrapText="false" VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
   </padding>
</VBox>
