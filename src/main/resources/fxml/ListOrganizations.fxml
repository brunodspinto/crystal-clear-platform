<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.ListOrganizationsFXController">
   <children>
      <Label styleClass="scene-title" text="List Institutions" />
      <TableView fx:id="orgTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colType" prefWidth="160.0" text="Type" />
            <TableColumn fx:id="colName" prefWidth="300.0" text="Name" />
            <TableColumn fx:id="colNature" prefWidth="140.0" text="Nature" />
         </columns>
         <placeholder>
            <Label text="No institutions registered yet." />
         </placeholder>
      </TableView>
      <Label fx:id="messageLabel" maxWidth="Infinity" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="28.0" right="28.0" top="20.0" />
   </padding>
</VBox>
