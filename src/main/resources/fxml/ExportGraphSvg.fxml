<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.ExportGraphSvgFXController">
   <children>
      <Label styleClass="scene-title" text="Export Graph to SVG (with Hyperlinks)" />
      <Label text="Builds the graph from the entities and relations CSV files and exports it as an interactive SVG file using Graphviz." wrapText="true" />
      <GridPane hgap="12.0" vgap="8.0">
         <children>
            <Label styleClass="field-label" text="Entities CSV:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="entitiesPathField" promptText="e.g. entities.csv" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Button mnemonicParsing="false" onAction="#handleBrowseEntities" styleClass="secondary-button" text="Browse..." GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <Label styleClass="field-label" text="Relations CSV:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="relationsPathField" promptText="e.g. relations.csv" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button mnemonicParsing="false" onAction="#handleBrowseRelations" styleClass="secondary-button" text="Browse..." GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Label styleClass="field-label" text="Output SVG:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="outputPathField" promptText="e.g. graph.svg" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button mnemonicParsing="false" onAction="#handleBrowseOutput" styleClass="secondary-button" text="Browse..." GridPane.columnIndex="2" GridPane.rowIndex="2" />
         </children>
         <columnConstraints>
            <ColumnConstraints minWidth="110.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="300.0" />
            <ColumnConstraints minWidth="90.0" />
         </columnConstraints>
      </GridPane>
      <Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleExport" styleClass="primary-button" text="Export" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="28.0" right="28.0" top="20.0" />
   </padding>
</VBox>
