<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ipp.isep.dei.ui.gui.ExportGraphSvgFXController"
      styleClass="root-pane"
      stylesheets="@../css/app.css"
      spacing="10">
    <padding><Insets top="20" right="28" bottom="20" left="28"/></padding>

    <Label text="US26 — Export Graph to SVG (with Hyperlinks)" styleClass="scene-title"/>
    <Label text="Builds the graph from the entities and relations CSV files and exports it as an interactive SVG file using Graphviz."
           wrapText="true"/>

    <GridPane hgap="12" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints minWidth="300" hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="90"/>
        </columnConstraints>

        <Label text="Entities CSV:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="entitiesPathField" promptText="e.g. entities.csv" styleClass="input-field"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button text="Browse..." onAction="#handleBrowseEntities" styleClass="secondary-button"
                GridPane.rowIndex="0" GridPane.columnIndex="2"/>

        <Label text="Relations CSV:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="relationsPathField" promptText="e.g. relations.csv" styleClass="input-field"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Button text="Browse..." onAction="#handleBrowseRelations" styleClass="secondary-button"
                GridPane.rowIndex="1" GridPane.columnIndex="2"/>

        <Label text="Output SVG:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="outputPathField" promptText="e.g. graph.svg" styleClass="input-field"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Button text="Browse..." onAction="#handleBrowseOutput" styleClass="secondary-button"
                GridPane.rowIndex="2" GridPane.columnIndex="2"/>
    </GridPane>

    <Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Export" onAction="#handleExport" defaultButton="true" styleClass="primary-button"/>
        <Button text="Back" onAction="#handleBack" styleClass="secondary-button"/>
    </HBox>
</VBox>
