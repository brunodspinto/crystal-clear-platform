<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.DetectConflictsFXController">
   <children>
      <Label styleClass="scene-title" text="Indirect Nepotism &amp; Conflicts of Interest" />
      <Label text="Analyses multi-hop relation chains in the loaded graph. Select the type of situation to investigate." wrapText="true" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label minWidth="120.0" styleClass="field-label" text="Question:" />
            <ComboBox fx:id="questionCombo" prefWidth="520.0" styleClass="combo-box" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label minWidth="120.0" styleClass="field-label" text="Organisation:" />
            <TextField fx:id="orgFilterField" prefWidth="280.0" promptText="Optional filter (question 2 only)" />
         </children>
      </HBox>
      <Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true" />
      <Label fx:id="resultLabel" maxWidth="Infinity" styleClass="field-label" wrapText="true" />
      <ListView fx:id="chainsList" prefHeight="220.0" VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleRunQuery" styleClass="primary-button" text="Run Query" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
   </padding>
</VBox>
