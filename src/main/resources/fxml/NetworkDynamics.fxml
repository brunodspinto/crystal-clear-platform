<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="480.0" prefWidth="720.0" spacing="10.0" styleClass="root-pane" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.ipp.isep.dei.ui.gui.NetworkDynamicsFXController">
   <children>
      <Label styleClass="scene-title" text="Network Dynamics Over Time" />
      <Label text="Add one or more snapshot dates, typed below or loaded from a CSV file (header SnapshotDate, one date per line); for each date a snapshot of the active entities and relations of the network is shown." wrapText="true" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label styleClass="field-label" text="Date:" />
            <TextField fx:id="dateField" prefWidth="160.0" promptText="yyyy-MM-dd" styleClass="input-field" />
            <Button mnemonicParsing="false" onAction="#handleAddDate" styleClass="primary-button" text="Add" />
            <Button mnemonicParsing="false" onAction="#handleRemoveDate" styleClass="secondary-button" text="Remove Selected" />
            <Button mnemonicParsing="false" onAction="#handleLoadCsv" styleClass="secondary-button" text="Load from CSV..." />
         </children>
      </HBox>
      <ListView fx:id="datesList" prefHeight="90.0" />
      <Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true" />
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Button defaultButton="true" mnemonicParsing="false" onAction="#handleGenerate" styleClass="primary-button" text="Generate Snapshots" />
            <Button cancelButton="true" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
         </children>
      </HBox>
      <TextArea fx:id="resultArea" editable="false" style="-fx-font-family: 'Courier New', monospace;" wrapText="false" VBox.vgrow="ALWAYS" />
   </children>
   <padding>
      <Insets bottom="20.0" left="28.0" right="28.0" top="20.0" />
   </padding>
</VBox>
